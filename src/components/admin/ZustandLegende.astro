---
// Nachtrag 24.10.2026 (K90): aufklappbare Erklärung „Was bedeuten die Zustände?“.
import { POSTEN_ZUSTAENDE, RECHNUNG_ZUSTAENDE, ANGEBOT_ZUSTAENDE, type ZustandErklaerung } from '../../lib/billing-zustaende';

interface Props { teile: ('posten' | 'rechnung' | 'angebot')[] }
const { teile } = Astro.props;
const gruppen: { titel: string; liste: ZustandErklaerung[] }[] = [
  ...(teile.includes('posten') ? [{ titel: 'Posten (Sitzungen und Positionen)', liste: POSTEN_ZUSTAENDE }] : []),
  ...(teile.includes('rechnung') ? [{ titel: 'Rechnungen', liste: RECHNUNG_ZUSTAENDE }] : []),
  ...(teile.includes('angebot') ? [{ titel: 'Angebotsvorschläge', liste: ANGEBOT_ZUSTAENDE }] : []),
];
---

<details class="legende mb-4 text-xs">
  <summary class="cursor-pointer inline-block px-2 py-1 rounded border border-dark-lighter text-muted">ⓘ Was bedeuten die Zustände?</summary>
  <div class="mt-2 border border-dark-lighter rounded-lg p-3">
    {gruppen.map((g) => (
      <div class="mb-3 last:mb-0">
        <p class="font-semibold text-light mb-1">{g.titel}</p>
        <table class="w-full"><tbody>{g.liste.map((z) => (
          <tr class="border-t border-dark-lighter align-top">
            <td class="py-1 pr-3 whitespace-nowrap text-gold">{z.name}</td>
            <td class="py-1 pr-3 text-light">{z.heisst}</td>
            <td class="py-1 text-muted">{z.geht}</td>
          </tr>))}</tbody></table>
      </div>
    ))}
  </div>
</details>
