---
import { icons } from '../../layouts/admin-icons';
import { buildNavSections, isActive } from '../../lib/admin/nav-items';

interface Props {
  brandWord: string;
  isKore: boolean;
  inboxPending: number;
  brettUrl: string;
  path: string;
}

const { inboxPending, brettUrl, path } = Astro.props;

// Definition liegt in src/lib/admin/nav-items.ts, damit der Guard sie importieren und
// jeden href gegen REDIRECT_MAP auflösen kann (T003826). Diese Komponente rendert nur.
const navSections = buildNavSections({ inboxPending, brettUrl });
---

<nav style="flex:1; overflow-y:auto; padding:16px 0; display:flex; flex-direction:column;">
  {navSections.map((section, si) => (
    <div class="sidebar-group">
      {section.label ? <p class="sidebar-group-label">{section.label}</p> : null}
      {section.items.map(item => (
        <a
          href={item.href}
          class:list={[
            'sidebar-nav-item',
            { 'is-active': isActive(path, item.href, item.matches) }
          ]}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          title={item.label}
        >
          <span class="nav-icon" set:html={icons[item.icon]} />
          <span class="sidebar-label" style="margin-left:12px; flex:1;">{item.label}</span>
          {item.badge ? (
            <span class="sidebar-label" style="padding:2px 6px; border-radius:6px; background:var(--admin-primary); color:var(--admin-bg); font-size:10px; font-weight:800;">{item.badge}</span>
          ) : null}
        </a>
      ))}
      {si < navSections.length - 1 ? (
        <div style="height:1px; background:var(--admin-border); margin:8px 16px;" aria-hidden="true"></div>
      ) : null}
    </div>
  ))}
</nav>
