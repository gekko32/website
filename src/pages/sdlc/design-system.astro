---
import Layout from '../../layouts/Layout.astro';
import '../../styles/sdlc-leitstand.css';
---

<Layout title="Leitstand Design System" rawTitle>
  <div class="ls-showcase">
    <header class="ls-showcase__section">
      <span class="ls-showcase__eyebrow">Leitstand Design System</span>
      <h1 class="ls-showcase__title">Control Room — Token-Referenz &amp; Showcase</h1>
      <p class="ls-showcase__lede">
        Bewusster Stilbruch zur Kore-Marke: signal-dominant, dark-first,
        Mono-Ziffern, kantige Panels. Alle Werte stammen aus
        <code class="ls-showcase__mono">sdlc-leitstand.css</code> (Token-Prefix
        <code class="ls-showcase__mono">--ls-*</code>).
      </p>
    </header>

    <section class="ls-showcase__section">
      <h2>Surfaces &amp; Linien</h2>
      <div class="ls-ds-grid cols-4">
        <div class="ls-swatch"><div class="fill" style={`background: var(--ls-bg)`}></div>
          <div class="meta"><span class="nm">Background</span><span class="vl">--ls-bg</span></div></div>
        <div class="ls-swatch"><div class="fill" style={`background: var(--ls-surface-base)`}></div>
          <div class="meta"><span class="nm">Surface Base</span><span class="vl">--ls-surface-base</span></div></div>
        <div class="ls-swatch"><div class="fill" style={`background: var(--ls-surface-raised)`}></div>
          <div class="meta"><span class="nm">Surface Raised</span><span class="vl">--ls-surface-raised</span></div></div>
        <div class="ls-swatch"><div class="fill" style={`background: var(--ls-line)`}></div>
          <div class="meta"><span class="nm">Line</span><span class="vl">--ls-line</span></div></div>
        <div class="ls-swatch"><div class="fill" style={`background: var(--ls-line-strong)`}></div>
          <div class="meta"><span class="nm">Line Strong</span><span class="vl">--ls-line-strong</span></div></div>
        <div class="ls-swatch"><div class="fill" style={`background: var(--ls-surface-base); display:flex; align-items:center; justify-content:center; color: var(--ls-text-primary); font-family: var(--ls-font-mono)`}>Aa 01</div>
          <div class="meta"><span class="nm">Text Primary</span><span class="vl">--ls-text-primary</span></div></div>
      </div>
    </section>

    <section class="ls-showcase__section">
      <h2>Text-Stufen</h2>
      <div class="ls-showcase__text-row" style={`color: var(--ls-text-primary)`}>
        <span class="ls-showcase__mono ls-showcase__text-token">--ls-text-primary</span>
        <span class="ls-showcase__text-sample">Leitstand</span>
      </div>
      <div class="ls-showcase__text-row" style={`color: var(--ls-text-secondary)`}>
        <span class="ls-showcase__mono ls-showcase__text-token">--ls-text-secondary</span>
        <span class="ls-showcase__text-sample">Leitstand</span>
      </div>
      <div class="ls-showcase__text-row" style={`color: var(--ls-text-muted)`}>
        <span class="ls-showcase__mono ls-showcase__text-token">--ls-text-muted</span>
        <span class="ls-showcase__text-sample">Leitstand</span>
      </div>
      <div class="ls-showcase__text-row" style={`color: var(--ls-text-disabled)`}>
        <span class="ls-showcase__mono ls-showcase__text-token">--ls-text-disabled</span>
        <span class="ls-showcase__text-sample">Leitstand</span>
      </div>
    </section>

    <section class="ls-showcase__section">
      <h2>Signal-Set</h2>
      <div class="ls-ds-grid cols-4">
        <div class="ls-swatch"><div class="fill" style={`background: var(--ls-signal-green-dim); display:flex; align-items:center; justify-content:center`}><span class="ls-signal-dot" style={`color: var(--ls-signal-green)`}></span></div>
          <div class="meta"><span class="nm">Green</span><span class="vl">--ls-signal-green</span></div></div>
        <div class="ls-swatch"><div class="fill" style={`background: var(--ls-signal-amber-dim); display:flex; align-items:center; justify-content:center`}><span class="ls-signal-dot" style={`color: var(--ls-signal-amber)`}></span></div>
          <div class="meta"><span class="nm">Amber</span><span class="vl">--ls-signal-amber</span></div></div>
        <div class="ls-swatch"><div class="fill" style={`background: var(--ls-signal-red-dim); display:flex; align-items:center; justify-content:center`}><span class="ls-signal-dot" style={`color: var(--ls-signal-red)`}></span></div>
          <div class="meta"><span class="nm">Red</span><span class="vl">--ls-signal-red</span></div></div>
        <div class="ls-swatch"><div class="fill" style={`background: var(--ls-signal-info-dim); display:flex; align-items:center; justify-content:center`}><span class="ls-signal-dot" style={`color: var(--ls-signal-info)`}></span></div>
          <div class="meta"><span class="nm">Info</span><span class="vl">--ls-signal-info</span></div></div>
      </div>
    </section>

    <section class="ls-showcase__section">
      <h2>Mono-Typografie</h2>
      <p class="ls-showcase__mono">T007559 · Countdown 00:42:07 · Queue 7 · Fleet 26/26</p>
    </section>

    <section class="ls-showcase__section">
      <h2>Radien &amp; Abstand</h2>
      <div class="ls-ds-grid cols-3">
        <div class="ls-showcase__radius" style={`border-radius: var(--ls-radius-sm)`}>
          <span class="ls-showcase__mono">--ls-radius-sm</span>
        </div>
        <div class="ls-showcase__radius" style={`border-radius: var(--ls-radius-md)`}>
          <span class="ls-showcase__mono">--ls-radius-md</span>
        </div>
        <div class="ls-showcase__radius" style={`border-radius: var(--ls-radius-lg)`}>
          <span class="ls-showcase__mono">--ls-radius-lg</span>
        </div>
      </div>
      <div class="ls-showcase__spaces">
        <div class="ls-showcase__space-row">
          <span class="ls-showcase__space-bar" style={`width: var(--ls-space-1)`}></span>
          <span class="ls-showcase__mono">--ls-space-1</span>
        </div>
        <div class="ls-showcase__space-row">
          <span class="ls-showcase__space-bar" style={`width: var(--ls-space-2)`}></span>
          <span class="ls-showcase__mono">--ls-space-2</span>
        </div>
        <div class="ls-showcase__space-row">
          <span class="ls-showcase__space-bar" style={`width: var(--ls-space-3)`}></span>
          <span class="ls-showcase__mono">--ls-space-3</span>
        </div>
        <div class="ls-showcase__space-row">
          <span class="ls-showcase__space-bar" style={`width: var(--ls-space-4)`}></span>
          <span class="ls-showcase__mono">--ls-space-4</span>
        </div>
        <div class="ls-showcase__space-row">
          <span class="ls-showcase__space-bar" style={`width: var(--ls-space-5)`}></span>
          <span class="ls-showcase__mono">--ls-space-5</span>
        </div>
        <div class="ls-showcase__space-row">
          <span class="ls-showcase__space-bar" style={`width: var(--ls-space-6)`}></span>
          <span class="ls-showcase__mono">--ls-space-6</span>
        </div>
        <div class="ls-showcase__space-row">
          <span class="ls-showcase__space-bar" style={`width: var(--ls-space-7)`}></span>
          <span class="ls-showcase__mono">--ls-space-7</span>
        </div>
      </div>
    </section>

    <section class="ls-showcase__section">
      <h2>Glow/Puls — nur &quot;läuft&quot;</h2>
      <div class="ls-showcase__row">
        <div class="ls-showcase__pulse-demo">
          <span class="ls-signal-dot ls-running" style={`color: var(--ls-signal-amber)`}></span>
          <span class="ls-showcase__mono">läuft</span>
        </div>
        <div class="ls-showcase__pulse-demo">
          <span class="ls-signal-dot" style={`color: var(--ls-signal-amber)`}></span>
          <span class="ls-showcase__mono">ruhig</span>
        </div>
      </div>
      <p class="ls-showcase__lede">
        Die Animation ist global an <code class="ls-showcase__mono">.ls-running</code>
        gebunden (sdlc-leitstand.css) — Glow/Puls nur für &quot;läuft gerade&quot;-Zustände.
      </p>
    </section>

    <section class="ls-showcase__section">
      <h2>Print-Light (Report-Ansicht)</h2>
      <div class="ls-shell report ls-showcase__report-demo">
        <p class="ls-showcase__eyebrow">Report-Ansicht</p>
        <p>Dieser Block nutzt die Modifier-Klasse <code>.report</code> auf dem
          Shell-Root (<code>.ls-shell.report</code>) — dieselbe Regelmenge gilt
          unter <code>@media print</code> für jeden Druck. Kein zweites
          interaktives Theme: auf dem Bildschirm hat die Klasse nur mit
          <code>?report=1</code> Wirkung, öffnen Sie die Druckvorschau des
          Browsers (Strg/Cmd+P), um die Farben zu sehen.</p>
      </div>
    </section>

    <section class="ls-showcase__section">
      <h2>Komponenten-Vorschau</h2>
      <h3 class="ls-showcase__subhead">Statusband</h3>
      <div class="ls-band">
        <div class="item"><span class="lbl">Tick</span><span class="val">00:42</span></div>
        <div class="item"><span class="lbl">Queue</span><span class="val" style={`color: var(--ls-signal-amber)`}>7</span></div>
        <div class="item"><span class="lbl">Fleet</span><span class="val" style={`color: var(--ls-signal-green)`}>26/26</span></div>
        <div class="item"><span class="lbl">Kill</span><span class="val" style={`color: var(--ls-signal-red)`}>aus</span></div>
        <div class="item"><span class="lbl">Budget</span><span class="val">62%</span></div>
      </div>
      <h3 class="ls-showcase__subhead">Stations-Karte</h3>
      <div class="ls-station">
        <div class="item"><span class="lbl">Station</span><span class="val">Verify</span></div>
        <span class="ls-signal-dot" style={`color: var(--ls-signal-amber)`}></span>
        <span class="ls-chip" style={`color: var(--ls-text-secondary)`}>4 Tickets</span>
      </div>
      <h3 class="ls-showcase__subhead">KPI-Kachel</h3>
      <div class="ls-ds-grid cols-3">
        <div class="ls-kpi"><span class="val">14</span><br/><span class="lbl">Lead Time (h)</span></div>
        <div class="ls-kpi"><span class="val" style={`color: var(--ls-signal-green)`}>96%</span><br/><span class="lbl">Deploy Success</span></div>
        <div class="ls-kpi"><span class="val" style={`color: var(--ls-signal-red)`}>2</span><br/><span class="lbl">CFR (Wochen)</span></div>
      </div>
      <h3 class="ls-showcase__subhead">Ticket-Chip</h3>
      <div class="ls-showcase__row">
        <span class="ls-chip" style={`color: var(--ls-signal-green)`}>T007559 - erledigt</span>
        <span class="ls-chip" style={`color: var(--ls-signal-amber)`}>T007560 - laeuft</span>
        <span class="ls-chip" style={`color: var(--ls-text-secondary)`}>T007561 - offen</span>
      </div>
    </section>
  </div>
</Layout>

<style>
  .ls-showcase {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--ls-space-7) var(--ls-space-6);
    background: var(--ls-bg);
    color: var(--ls-text-primary);
    font-family: var(--ls-font-sans);
  }

  .ls-showcase__title {
    font-size: 30px;
    line-height: 1.1;
    margin: var(--ls-space-3) 0 var(--ls-space-3);
    color: var(--ls-text-primary);
  }

  .ls-showcase__lede {
    color: var(--ls-text-secondary);
    max-width: 72ch;
    margin: 0;
  }

  .ls-showcase__section {
    margin-bottom: var(--ls-space-7);
  }

  .ls-showcase__section h2 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 var(--ls-space-5);
    padding-bottom: var(--ls-space-3);
    border-bottom: 1px solid var(--ls-line);
    color: var(--ls-text-primary);
  }

  .ls-showcase__subhead {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    margin: var(--ls-space-6) 0 var(--ls-space-4);
    color: var(--ls-text-muted);
  }

  .ls-showcase__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ls-space-5);
    align-items: center;
  }

  .ls-showcase__eyebrow {
    font-family: var(--ls-font-mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ls-text-muted);
  }

  .ls-showcase__mono {
    font-family: var(--ls-font-mono);
    color: var(--ls-text-primary);
  }

  .ls-showcase__text-row {
    display: flex;
    align-items: center;
    gap: var(--ls-space-5);
    padding: var(--ls-space-3) 0;
    border-bottom: 1px solid var(--ls-line);
  }

  .ls-showcase__text-token {
    min-width: 180px;
    font-size: 12px;
    color: var(--ls-text-muted);
  }

  .ls-showcase__text-sample {
    font-size: 18px;
  }

  .ls-showcase__radius {
    border: 1px solid var(--ls-line-strong);
    background: var(--ls-surface-base);
    padding: var(--ls-space-5);
    text-align: center;
  }

  .ls-showcase__spaces {
    margin-top: var(--ls-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--ls-space-3);
  }

  .ls-showcase__space-row {
    display: flex;
    align-items: center;
    gap: var(--ls-space-3);
  }

  .ls-showcase__space-bar {
    height: var(--ls-space-4);
    background: var(--ls-line-strong);
    border-radius: var(--ls-radius-sm);
  }

  .ls-showcase__pulse-demo {
    display: flex;
    align-items: center;
    gap: var(--ls-space-3);
    padding: var(--ls-space-4) var(--ls-space-5);
    border: 1px solid var(--ls-line-strong);
    border-radius: var(--ls-radius-md);
    background: var(--ls-surface-base);
  }

  .ls-showcase__report-demo {
    border: 1px dashed var(--ls-line-strong);
    border-radius: var(--ls-radius-md);
    padding: var(--ls-space-6);
  }

  .ls-ds-grid {
    display: grid;
    gap: var(--ls-space-6);
  }

  .cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .cols-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .ls-swatch {
    border: 1px solid var(--ls-line-strong);
    border-radius: var(--ls-radius-md);
    overflow: hidden;
  }

  .ls-swatch .fill {
    height: 72px;
  }

  .ls-swatch .meta {
    padding: var(--ls-space-4) var(--ls-space-5);
    background: var(--ls-surface-base);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .ls-swatch .nm {
    font: 500 13px/1.2 var(--ls-font-sans);
    color: var(--ls-text-primary);
  }

  .ls-swatch .vl {
    font: 400 11px/1.3 var(--ls-font-mono);
    color: var(--ls-text-muted);
  }

  .ls-signal-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: currentColor;
  }

  .ls-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--ls-space-3);
    padding: var(--ls-space-2) var(--ls-space-4);
    border-radius: var(--ls-radius-lg);
    border: 1px solid var(--ls-line-strong);
    background: var(--ls-surface-base);
    font: 500 12px/1 var(--ls-font-mono);
    color: var(--ls-text-primary);
  }

  .ls-kpi {
    border: 1px solid var(--ls-line-strong);
    border-radius: var(--ls-radius-md);
    background: var(--ls-surface-base);
    padding: var(--ls-space-5);
  }

  .ls-kpi .val {
    font: 600 26px/1 var(--ls-font-mono);
    color: var(--ls-text-primary);
  }

  .ls-kpi .lbl {
    font: 400 11px/1.3 var(--ls-font-sans);
    color: var(--ls-text-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .ls-station {
    border: 1px solid var(--ls-line-strong);
    border-radius: var(--ls-radius-md);
    background: var(--ls-surface-base);
    padding: var(--ls-space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ls-space-4);
  }

  .ls-band {
    display: flex;
    gap: var(--ls-space-6);
    align-items: center;
    padding: var(--ls-space-4) var(--ls-space-5);
    border: 1px solid var(--ls-line-strong);
    border-radius: var(--ls-radius-md);
    background: var(--ls-surface-base);
  }

  .ls-band .item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ls-band .item .lbl {
    font: 400 10px/1.2 var(--ls-font-sans);
    color: var(--ls-text-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .ls-band .item .val {
    font: 500 14px/1.2 var(--ls-font-mono);
    color: var(--ls-text-primary);
  }

  @media (max-width: 720px) {
    .cols-3,
    .cols-4 {
      grid-template-columns: 1fr;
    }

    .ls-band {
      flex-wrap: wrap;
    }
  }
</style>
