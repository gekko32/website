---
import { requireOwner, ownerBusiness } from '../../lib/owner-guard';
import { getLoginUrl } from '../../lib/auth';
import { listInboxItems } from '../../lib/messaging-db';
import { deriveClients, searchClients } from '../../lib/clients';

const session = await requireOwner(Astro.request.headers.get('cookie'));
if (!session) return Astro.redirect(getLoginUrl(Astro.url.pathname));

const brand = ownerBusiness(session).brand ?? process.env.BRAND ?? 'mentolder';
// Strict owner isolation: only this brand's booking rows, test rows excluded
// by listInboxItems. No client-side JavaScript — plain GET form below.
const rows = await listInboxItems({ brand, type: 'booking' });
const query = (Astro.url.searchParams.get('q') ?? '').trim();
const clients = searchClients(deriveClients(rows), query);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kunden — Owner-Bereich</title>
    <style>
      body { font-family: system-ui, sans-serif; margin: 0; padding: 32px 20px; color: #222; background: #fafafa; }
      main { max-width: 760px; margin: 0 auto; }
      article { background: #fff; border: 1px solid #e3e3e3; border-radius: 12px; padding: 20px 24px; margin: 16px 0; }
      ul { list-style: none; margin: 0; padding: 0; }
      form { margin: 16px 0; }
      input[type="search"] { font: inherit; padding: 10px 12px; min-height: 44px; border: 1px solid #ccc; border-radius: 8px; width: 280px; max-width: 100%; }
      button { margin-top: 8px; padding: 10px 20px; min-height: 44px; border-radius: 8px; border: 1px solid #333; background: #222; color: #fff; font: inherit; cursor: pointer; }
    </style>
  </head>
  <body>
    <main>
      <h1>Kunden</h1>
      <p>Angemeldet als {session.name} ({session.email}).</p>
      <form method="get" action="/owner/kunden">
        <label>Suche nach Name oder E-Mail
          <input type="search" name="q" value={query} maxlength="200" />
        </label>
        <button type="submit">Suchen</button>
      </form>
      {clients.length === 0 ? (
        <ul>
          {query === '' ? (
            <li>Noch keine Kunden vorhanden.</li>
          ) : (
            <li>Keine Kunden für diese Suche gefunden.</li>
          )}
        </ul>
      ) : (
        <ul>
          {clients.map((client) => (
            <li>
              <article>
                <h2>{client.name === '' ? client.email : client.name}</h2>
                <p>{client.email}{client.phone ? ` · ${client.phone}` : ''}</p>
                <p>{client.requestCount} {client.requestCount === 1 ? 'Anfrage' : 'Anfragen'}{client.openCount > 0 ? ` (${client.openCount} offen)` : ''}</p>
                <p><a href={`/owner/kunden/${encodeURIComponent(client.id)}`}>Details ansehen</a></p>
              </article>
            </li>
          ))}
        </ul>
      )}
      <nav>
        <a href="/owner">Zurück zur Übersicht</a>
      </nav>
    </main>
  </body>
</html>
