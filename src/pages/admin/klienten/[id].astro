---
// Klientenakte (Stufe 2, Gerald 19.10.2026): eine Akte pro Klient, auch ohne Benutzerkonto.
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/ui/AdminPageHeader.svelte';
import KlientFormular from '../../../components/admin/KlientFormular.svelte';
import ZustandLegende from '../../../components/admin/ZustandLegende.astro';
import ProtokollTabelle from '../../../components/admin/ProtokollTabelle.astro';
import AkteEintraege from '../../../components/admin/AkteEintraege.astro';
import { leseProtokoll } from '../../../lib/akte-protokoll';
import { eintraegeDesKlienten, type AkteEintrag } from '../../../lib/akte-dokumente';
import { getSession, getLoginUrl, isAdmin } from '../../../lib/auth';
import { getKlient, akteVerlauf, rechnungsempfaenger } from '../../../lib/klientenakte';
import { listeLeistungen, listeKategorien, preisAnzeige } from '../../../lib/billing-leistungen';
import { gebuchteTermine } from '../../../lib/billing-ausfall';
import { ladeEinheiten } from '../../../lib/billing-einheiten';
import { verbucheUndEntwerfe, wirksameAbrechnungsart } from '../../../lib/billing-abrechnungslauf';
import { getTaxMode } from '../../../lib/tax-monitor';
import { angeboteDesKlienten, sortiereAngebote, istAktiv, standText, type Angebot } from '../../../lib/billing-angebot';
import { ladeRegeln } from '../../../lib/billing-regeln';
import { anzeigeEmail, hatEchteEmail } from '../../../lib/billing-versand';
import { postenDesKlienten, postenBetrag, AUFTRAG_STAND_TEXT, auftragMitAngebotLoeschbar, postenImEntwurfAenderbar, auftraegeDesKlienten, terminAbgesagt, postenLoeschbar, auftragLoeschbar, leistungszeitraum, HERKUNFT_TEXT, ZUSTAND_TEXT, type Posten, type Auftrag } from '../../../lib/billing-posten';

const session = await getSession(Astro.request.headers.get('cookie'));
if (!session) return Astro.redirect(getLoginUrl(Astro.url.pathname));
if (!isAdmin(session)) return Astro.redirect('/admin');

const klient = await getKlient(Astro.params.id ?? '');
if (!klient) return Astro.redirect('/admin/klienten');

const brand = process.env.BRAND || 'mentolder';
const empfaenger = rechnungsempfaenger(klient);

const datum = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('de-DE') : '–';
const zeit = (d: string | Date | null) => d ? new Date(d).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' }) : '–';
const euro = (n: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(n);
const STATUS: Record<string, string> = { draft: 'Entwurf', open: 'offen', paid: 'bezahlt', partially_paid: 'teilweise bezahlt', overdue: 'überfällig', void: 'storniert', uncollectible: 'uneinbringlich', cancelled: 'storniert' };

// Rechnungswesen Stufe 3, T5/T6: vergangene, freigegebene Termine zuerst als Posten
// übernehmen, dann Posten und „Sitzung erfassen“ (K11, K12, K14, K16).
// T10b: danach für Klienten „je Sitzung“ je Posten einen Entwurf anlegen (K27).
await verbucheUndEntwerfe(brand);
const regeln = await ladeRegeln(brand);
const voreinstellung = { firma: regeln.abrechnungsartFirma, privat: regeln.abrechnungsartPrivat };
const abrechnungsart = wirksameAbrechnungsart(klient, regeln);
// Erst nach dem Anlegen der Entwürfe lesen, damit neue Entwürfe in der Liste stehen.
const { termine, sitzungen, rechnungen } = await akteVerlauf(klient, brand);
const [posten, aktiveLeistungen, kategorien] = await Promise.all([
  postenDesKlienten(brand, klient.id).catch((): Posten[] => []),
  listeLeistungen(brand, { nurAktiv: true }).catch(() => []),
  listeKategorien(brand).catch(() => []),
]);
const offene = posten.filter((p) => p.zustand === 'offen');
const abrechnungsPosten = posten.filter((p) => p.zustand !== 'geplant');
const offenSumme = offene.reduce((s, p) => Math.round((s + postenBetrag(p)) * 100) / 100, 0);
const q = Astro.url.searchParams;
function jsonParam<T>(name: string, fallback: T): T {
  try { return JSON.parse(q.get(name) ?? '') as T; } catch { return fallback; }
}
const sfRoh = jsonParam<{ key: string; meldung: string }[]>('sitzungFehler', []);
const sitzungFehler = Array.isArray(sfRoh) ? sfRoh.filter((x) => x && typeof x.key === 'string' && typeof x.meldung === 'string') : [];
const seRoh = jsonParam<Record<string, string | boolean>>('sitzungEingabe', {});
const se = seRoh && typeof seRoh === 'object' && !Array.isArray(seRoh) ? seRoh : {};
const sfFuer = (k: string) => sitzungFehler.find((f) => f.key === k)?.meldung;
const heute = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Berlin' });
const postenGespeichert = q.get('gespeichert') === '1';
// T8: individuelle Aufträge mit eigenen Positionen (K8–K10).
const auftraege = await auftraegeDesKlienten(brand, klient.id).catch((): Auftrag[] => []);
const auftragFehler = q.get('auftragFehler');
// Stufe 4 T16: Angebote der Akte (je Auftrag angezeigt; Liste „Angebote“ in T18).
// Nachtrag 24.10.2026 (K84): aktive zuerst, dann die abgeschlossenen.
const angebote = sortiereAngebote(await angeboteDesKlienten(brand, klient.id).catch((): Angebot[] => []));
const ersterAbgeschlossen = angebote.findIndex((x) => !istAktiv(x));
// Änderungsprotokoll (K96).
const protokoll = await leseProtokoll(brand, { klientId: klient.id, limit: 30 }).catch(() => ({ zeilen: [], mehr: false }));
// Notizen und Dokumente (K103).
const eintraege = await eintraegeDesKlienten(brand, klient.id).catch((): AkteEintrag[] => []);
const angeboteVon = (auftragId: string) => angebote.filter((x) => x.auftragId === auftragId);
const positionenVon = (auftragId: string) => posten.filter((p) => p.auftragId === auftragId);
const zahlFeld = (n: number | null) => (n === null ? '' : String(n).replace('.', ','));
// T9: gebuchte Termine mit Absage-Vermerk (AE8).
const gebucht = await gebuchteTermine(klient.email).catch(() => []);
const leistungsName = new Map(aktiveLeistungen.map((l) => [l.key, l.name]));
const ABSAGE_TEXT: Record<string, string> = { kunde: 'durch Kunde', gerald: 'durch mich', nicht_erschienen: 'nicht erschienen', umbuchung: 'verschoben' };
const postenFehler = q.get('fehler');
// T10a: Rechnung aus gewählten Posten; Nummer der Rechnung, auf der ein Posten steht.
const entwurfAngelegt = q.get('entwurf');
// K127 (Handtest 29.10.2026): offene Rechnungsentwürfe dieses Klienten deutlich nennen.
const offeneEntwuerfe = rechnungen.filter((r) => r.status === 'draft');
// K142: aktuelle Steuerart sichtbar, mit Weg zur Umstellung.
const steuerart = await getTaxMode(brand).catch(() => 'kleinunternehmer' as const);
const rechnungNummer = new Map(rechnungen.map((r) => [String(r.id), r.number]));
// K90: bei „abgerechnet“ auch der Zustand der Rechnung (offen, bezahlt, storniert …).
const rechnungZustand = new Map(rechnungen.map((r) => [String(r.id), STATUS[r.status] ?? r.status]));
const waehlbar = (p: Posten) => p.zustand === 'offen' && p.einzelpreis !== null;
// Einheiten als Auswahl (Handtest 21.10.2026); gepflegt unter Einstellungen → Regeln.
// Ein alter Wert, der nicht mehr in der Liste steht, bleibt wählbar.
const einheiten = await ladeEinheiten(brand);
const einheitOptionen = (aktuell: string | null) => (aktuell && !einheiten.includes(aktuell) ? [aktuell, ...einheiten] : einheiten);
---

<AdminLayout title={`Akte ${klient.name}`}>
  <div style="padding:2rem;max-width:960px;">
    <p class="text-xs text-muted mb-2"><a class="hover:underline" href="/admin/klienten">← Alle Klienten</a></p>
    <div class="flex flex-wrap items-start justify-between gap-3 mb-6">
      <AdminPageHeader title={klient.name}
        description={`Kundennummer ${klient.customer_number ?? '–'}`} />
      <div class="flex flex-wrap gap-2 items-center">
        {/* Handtest 22.10.2026: statt der alten Maske (eine Leistung, ohne Posten) zur Abrechnung springen. */}
        <a href="#abrechnung" id="rechnung-erstellen-sprung" class="px-3 py-2 rounded-lg bg-gold text-dark text-sm font-semibold">Rechnung erstellen</a>
        {klient.hat_konto
          ? <a class="px-3 py-2 rounded-lg border border-dark-lighter text-sm" href={`/admin/${klient.keycloak_user_id}`}>Konto öffnen</a>
          : hatEchteEmail(klient.email)
            ? <button id="konto-einrichten" data-id={klient.id}
                class="px-3 py-2 rounded-lg border border-dark-lighter text-sm">Konto einrichten</button>
            : <button type="button" disabled title="Ein Konto braucht eine E-Mail-Adresse (Stammdaten)."
                class="px-3 py-2 rounded-lg border border-dark-lighter text-sm opacity-40 cursor-not-allowed">Konto einrichten</button>}
      </div>
    </div>
    <p id="konto-meldung" class="text-sm mb-4"></p>

    {/* Handtest 22.10.2026: Stammdaten oben und zugeklappt – erst stimmen sie, dann wird erfasst.
        Fehlt die Anschrift, ist der Bereich offen. */}
    <details class="border border-dark-lighter rounded-xl p-4 mb-8" open={!empfaenger.addressLine1 || !empfaenger.city}>
      <summary class="cursor-pointer text-sm font-semibold text-gold">Stammdaten und Rechnungsanschrift
        {(!empfaenger.addressLine1 || !empfaenger.city) && <span class="ml-2 text-xs font-normal text-red-400">Anschrift unvollständig</span>}</summary>
      <div class="mt-3">
        <p class="text-sm text-muted mb-2">{anzeigeEmail(klient.email)}{klient.phone ? ' · ' + klient.phone : ''}</p>
        <h3 class="text-xs text-muted uppercase tracking-wide mb-1">Rechnung geht an</h3>
        <p class="text-sm">
          {empfaenger.company ? <strong>{empfaenger.company}</strong> : <strong>{empfaenger.name}</strong>}
          {empfaenger.company && <span class="text-muted"> (z. Hd. {empfaenger.name})</span>}
          <br /><span class="text-muted">{[empfaenger.addressLine1, [empfaenger.postalCode, empfaenger.city].filter(Boolean).join(' ')].filter(Boolean).join(', ') || 'Anschrift fehlt noch'} · {anzeigeEmail(empfaenger.email)}</span>
          <br /><span class="text-muted">Abrechnung: {abrechnungsart === 'monatlich' ? 'monatlich (Sammelrechnung am Monatsersten)' : 'je Sitzung (jeder Posten sofort ein Entwurf)'}{!klient.abrechnungsart && ' – Voreinstellung'}</span>
        </p>
        <div class="mt-4"><KlientFormular klientId={klient.id} start={klient} {voreinstellung} client:load /></div>
      </div>
    </details>

    {/* Handtest 22.10.2026: alle Listen der Akte auf einmal auf- oder zuklappen. */}
    <div class="flex justify-end gap-2 mb-3 text-xs">
      <button type="button" id="listen-auf" class="px-2 py-1 rounded border border-dark-lighter">Alle Listen aufklappen</button>
      <button type="button" id="listen-zu" class="px-2 py-1 rounded border border-dark-lighter">Alle Listen zuklappen</button>
    </div>

    <section id="abrechnung" class="mb-8">
      <details class="liste" open>
      <summary class="liste-kopf cursor-pointer text-xs text-muted uppercase tracking-wide mb-2">
        Abrechnung · offen: {offene.length} {offene.length === 1 ? 'Posten' : 'Posten'} · {euro(offenSumme)}
      </summary>
      {postenGespeichert && <p class="text-sm text-green-400 mb-2">Gespeichert.</p>}
      <p class="text-xs text-muted mb-2">Steuerart: <span class="text-light">{steuerart === 'kleinunternehmer' ? '§ 19 UStG – keine Umsatzsteuer' : 'Regelbesteuerung – mit Umsatzsteuer'}</span>
        · <a class="underline" href="/admin/einstellungen/rechnungen">umstellen</a></p>
      {/* K127 (Handtest 29.10.2026): angelegte Entwürfe nicht nur unter Fakturierung verstecken. */}
      {offeneEntwuerfe.map((r) => (
        <div class="entwurf-hinweis mb-2">
          <span><strong>Rechnungsentwurf angelegt – noch nicht verschickt</strong> · {euro(Number(r.gross_amount))}</span>
          <a href={`/admin/rechnungen/entwurf/${r.id}`} class="px-3 py-1.5 rounded-lg bg-gold text-dark text-sm font-semibold">Entwurf prüfen</a>
        </div>
      ))}
      {entwurfAngelegt && offeneEntwuerfe.length === 0 && <p class="text-sm text-green-400 mb-2">Rechnungsentwurf {entwurfAngelegt} angelegt. Noch nichts verschickt:
        prüfen und versenden unter <a class="underline" href="/admin/rechnungen">Fakturierung → Rechnungsentwürfe</a>.</p>}
      {postenFehler && <p role="alert" class="text-sm text-red-400 mb-2">{postenFehler}</p>}
      <ZustandLegende teile={['posten', 'rechnung']} />

      {/* Handtest 22.10.2026: über der Liste, als Knopf wie „Auftrag anlegen“. */}
      <details class="mb-3" open={sitzungFehler.length > 0}>
        <summary class="cursor-pointer inline-block px-3 py-1.5 rounded-lg border border-gold text-gold text-sm">+ Sitzung erfassen</summary>
        <div class="border border-dark-lighter rounded-xl p-4 mt-2">
        <form method="POST" action="/api/admin/posten" autocomplete="off" class="mt-4 grid gap-3 merk-ungespeichert" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));">
          <input type="hidden" name="aktion" value="sitzung" />
          <input type="hidden" name="klientId" value={klient.id} />
          {sitzungFehler.length > 0 && <p role="alert" class="text-sm text-red-400" style="grid-column:1/-1;">Nicht gespeichert. Bitte die markierten Felder korrigieren.</p>}
          <label class="text-xs text-muted">Datum
            <input type="date" name="datum" required value={String(se.datum ?? heute)} class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light" />
            {sfFuer('datum') && <span class="block text-red-400">{sfFuer('datum')}</span>}
          </label>
          <label class="text-xs text-muted" style="grid-column:span 2;">Leistung
            <select id="sitzung-leistung" name="leistungKey" required class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light">
              <option value="">– wählen –</option>
              {/* Nach Bereichen gegliedert; Preis und Text werden beim Auswählen vorbelegt (Handtest L2). */}
              {kategorien.map((k) => {
                const inKat = aktiveLeistungen.filter((l) => l.kategorieId === k.id);
                return inKat.length > 0 && (
                  <optgroup label={`${k.icon} ${k.titel}`}>
                    {inKat.map((l) => (
                      <option value={l.key} selected={se.leistungKey === l.key}
                        data-preis={l.preis === null ? '' : String(l.preis).replace('.', ',')} data-text={l.name}>
                        {l.name} – {l.preis === null ? 'Preis eintragen' : `${preisAnzeige({ preis: l.preis, nachVereinbarung: false })}${l.einheit ? ' je ' + l.einheit : ''}`}
                      </option>))}
                  </optgroup>
                );
              })}
            </select>
            {sfFuer('leistungKey') && <span class="block text-red-400">{sfFuer('leistungKey')}</span>}
          </label>
          <label class="text-xs text-muted">Menge
            <input name="menge" inputmode="decimal" required value={String(se.menge ?? '1')} class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light" />
            {sfFuer('menge') && <span class="block text-red-400">{sfFuer('menge')}</span>}
          </label>
          <label class="text-xs text-muted">Preis je Einheit in €
            <input id="sitzung-preis" name="preis" inputmode="decimal" value={String(se.preis ?? '')} class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light" />
            {sfFuer('preis') && <span class="block text-red-400">{sfFuer('preis')}</span>}
          </label>
          <label class="text-xs text-muted" style="grid-column:1/-1;">Text auf der Rechnung
            <input id="sitzung-text" name="text" maxlength="300" value={String(se.text ?? '')} class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light" />
            {sfFuer('text') && <span class="block text-red-400">{sfFuer('text')}</span>}
          </label>
          <label class="text-sm text-light" style="grid-column:1/-1;">
            <input type="checkbox" name="nichtAbrechnen" checked={se.nichtAbrechnen === true} /> Von der Abrechnung ausnehmen (z. B. kostenloses Erstgespräch, Kulanz)
          </label>
          <div style="grid-column:1/-1;">
            <button type="submit" class="px-4 py-2 rounded-lg bg-gold text-dark text-sm font-semibold">Sitzung anlegen</button>
          </div>
        </form>
        </div>
      </details>
      {abrechnungsart === 'je_sitzung' && <p class="text-xs text-muted mb-2">Abrechnung je Sitzung: Jeder Posten mit Preis kommt von selbst
        auf einen eigenen Entwurf (Rechnungen → Entwürfe). Wird ein Entwurf verworfen, bleiben seine Posten offen, bis du sie hier selbst abrechnest.</p>}
      {/* T10a: links anlegen (Regel Gerald 22.10.2026): Häkchen bei den offenen Posten, dann Rechnung erstellen. */}
      {!posten.some(waehlbar) && <p id="rechnung-hinweis-leer" hidden class="text-sm text-gold mb-2">Keine offenen Posten mit Preis.
        Zuerst über „+ Sitzung erfassen“ oder einen Auftrag anlegen – dann hier ankreuzen und „Rechnung aus Auswahl erstellen“.</p>}
      {posten.some(waehlbar) && (
        <form id="f-rechnung" method="POST" action="/api/admin/posten" class="flex flex-wrap gap-2 items-center mb-2">
          <input type="hidden" name="aktion" value="rechnung" />
          <input type="hidden" name="klientId" value={klient.id} />
          <button type="submit" id="rechnung-erstellen" disabled class="px-3 py-1.5 rounded-lg bg-gold text-dark text-sm font-semibold disabled:opacity-40">
            Rechnung aus Auswahl erstellen
          </button>
          <button type="button" id="rechnung-alle" class="px-2 py-1 rounded border border-dark-lighter text-xs">Alle offenen ankreuzen</button>
          <span id="rechnung-summe" class="text-xs text-muted">Posten ankreuzen, die auf die Rechnung sollen.</span>
        </form>
      )}

      {/* Stufe 4 T15: geplante Positionen (Angebot noch nicht angenommen) stehen nur im Auftrag. */}
      {abrechnungsPosten.length === 0 ? <p class="text-sm text-muted mb-3">Noch keine Posten.</p> :
        <table class="w-full text-sm mb-4"><tbody>{abrechnungsPosten.map((p) => {
          // Handtest 22.10.2026: Ändern direkt in der Zeile statt in einem Kasten darunter.
          // Handtest 23.10.2026: bis zum Festschreiben änderbar, auch auf einem Entwurf.
          const aenderbar = postenImEntwurfAenderbar(p.zustand) && !terminAbgesagt(p) && p.herkunft !== 'auftrag';
          const f = `f-${p.id}`;
          return (
          <tr class={`zeile border-t border-dark-lighter ${p.zustand === 'offen' ? '' : 'opacity-60'}`}>
            <td class="py-1 pr-2 align-top w-6">
              {waehlbar(p) && <input type="checkbox" name="postenId" value={p.id} form="f-rechnung" class="rechnung-wahl"
                data-betrag={String(postenBetrag(p))} aria-label={`„${p.text}“ in die Rechnung aufnehmen`} />}
            </td>
            <td class="py-1 pr-3 whitespace-nowrap align-top">
              <span class="ansicht">{leistungszeitraum(p.datum, p.datumBis)}</span>
              {aenderbar && <span class="bearbeiten">
                <label class="text-xs text-muted">von<input type="date" name="datum" value={p.datum} form={f} class="zfeld" /></label>
                <label class="text-xs text-muted">bis<input type="date" name="datumBis" value={p.datumBis ?? ''} form={f} class="zfeld" /></label>
              </span>}
            </td>
            <td class="py-1 pr-3 align-top">
              <span class="ansicht">{p.text}</span>
              {aenderbar && <span class="bearbeiten"><input name="text" value={p.text} form={f} aria-label="Text auf der Rechnung" class="zfeld" /></span>}
              <span class="block text-xs text-muted">{HERKUNFT_TEXT[p.herkunft]}{p.notiz ? ` · ${p.notiz}` : ''}</span>
            </td>
            <td class="py-1 pr-3 text-right whitespace-nowrap text-muted align-top">
              {aenderbar && <span class="bearbeiten">
                <span class="inline-flex gap-1 items-center">
                  <input name="menge" value={zahlFeld(p.menge)} inputmode="decimal" form={f} aria-label="Menge" class="zfeld w-14" />
                  <select name="einheit" form={f} aria-label="Einheit" class="zfeld w-24">
                    <option value="" selected={!p.einheit}>–</option>
                    {einheitOptionen(p.einheit).map((e) => <option value={e} selected={e === p.einheit}>{e}</option>)}
                  </select>
                  ×
                  <input name="preis" value={zahlFeld(p.einzelpreis)} required inputmode="decimal" form={f} aria-label="Preis je Einheit in €" class="zfeld w-20" />
                </span>
              </span>}
              <span class="ansicht">
              {p.einzelpreis === null && (p.zustand === 'offen' || p.zustand === 'nicht_abrechnen') ? (
                <form method="POST" action="/api/admin/posten" class="inline-flex gap-1 items-center">
                  <input type="hidden" name="aktion" value="preis" />
                  <input type="hidden" name="postenId" value={p.id} />
                  <span>{p.menge.toLocaleString('de-DE')} ×</span>
                  <input name="preis" inputmode="decimal" required placeholder="Preis €" aria-label="Preis je Einheit"
                    class="w-20 px-1 py-0.5 rounded bg-dark border border-red-400 text-xs text-light" />
                  <button type="submit" class="px-2 py-0.5 rounded border border-dark-lighter text-xs">OK</button>
                </form>
              ) : <>{p.menge.toLocaleString('de-DE')}{p.einheit ? ` ${p.einheit}` : ''} × {p.einzelpreis === null ? '–' : euro(p.einzelpreis)}</>}
              </span>
            </td>
            <td class="py-1 pr-3 text-right whitespace-nowrap align-top">{p.einzelpreis === null ? <span class="text-red-400">Preis fehlt</span> : euro(postenBetrag(p))}</td>
            <td class="py-1 pr-3 text-muted whitespace-nowrap align-top">{ZUSTAND_TEXT[p.zustand]}
              {p.invoiceId && rechnungNummer.has(p.invoiceId) && (p.zustand === 'auf_entwurf'
                ? <a class="block text-xs font-mono text-gold underline" href={`/admin/rechnungen/entwurf/${p.invoiceId}`} title="Entwurf prüfen, ändern, verschicken">{rechnungNummer.get(p.invoiceId)} ›</a>
                : <a class="block text-xs font-mono hover:underline" href={`/admin/rechnungen/entwurf/${p.invoiceId}`} title="Rechnung öffnen: PDF, per E-Mail senden">{rechnungNummer.get(p.invoiceId)} · {rechnungZustand.get(p.invoiceId)} ›</a>)}</td>
            <td class="py-1 text-right whitespace-nowrap align-top">
              {aenderbar && <span class="bearbeiten">
                <form id={f} method="POST" action="/api/admin/posten" autocomplete="off" class="merk-ungespeichert inline">
                  <input type="hidden" name="aktion" value="position_aendern" />
                  <input type="hidden" name="bereich" value="abrechnung" />
                  <input type="hidden" name="postenId" value={p.id} />
                  <button type="submit" class="px-2 py-1 rounded bg-gold text-dark text-xs font-semibold">Speichern</button>
                </form>
                <button type="button" class="zeile-abbrechen px-2 py-1 rounded border border-dark-lighter text-xs" data-form={f}>Abbrechen</button>
              </span>}
              <span class="ansicht">
              {aenderbar && <button type="button" class="zeile-aendern px-2 py-1 rounded border border-gold text-gold text-xs">Ändern</button>}
              {p.herkunft === 'ausfall' && p.zustand === 'offen' ? (
                <form method="POST" action="/api/admin/posten" class="inline-flex gap-1 items-center">
                  <input type="hidden" name="aktion" value="erlassen" />
                  <input type="hidden" name="postenId" value={p.id} />
                  <input name="grund" maxlength="200" placeholder="Grund (z. B. krank)" aria-label="Grund für den Erlass"
                    class="w-28 px-1 py-0.5 rounded bg-dark border border-dark-lighter text-xs text-light" />
                  <button type="submit" class="px-2 py-1 rounded border border-dark-lighter text-xs">Erlassen</button>
                </form>
              ) : (p.zustand === 'offen' || p.zustand === 'nicht_abrechnen' || p.zustand === 'auf_entwurf') && !terminAbgesagt(p) && (
                <form method="POST" action="/api/admin/posten" style="display:inline;">
                  <input type="hidden" name="postenId" value={p.id} />
                  <input type="hidden" name="aktion" value={p.zustand === 'nicht_abrechnen' ? 'abrechnen' : 'nicht_abrechnen'} />
                  <button type="submit" class="px-2 py-1 rounded border border-dark-lighter text-xs"
                    title={p.zustand === 'nicht_abrechnen' ? 'Wieder in die Abrechnung aufnehmen' : 'Diesen Posten nicht in Rechnung stellen (z. B. Kulanz)'}>
                    {p.zustand === 'nicht_abrechnen' ? 'Wieder aufnehmen' : 'Ausnehmen'}
                  </button>
                </form>
              )}
              {p.zustand === 'auf_entwurf' && p.invoiceId && (
                <form method="POST" action="/api/admin/posten" class="posten-loeschen inline"
                  data-frage="Diesen Posten vom Rechnungsentwurf nehmen? Er bleibt als offener Posten in der Akte, der Entwurf behält die übrigen Positionen.">
                  <input type="hidden" name="aktion" value="vom_entwurf" />
                  <input type="hidden" name="postenId" value={p.id} />
                  <button type="submit" class="px-2 py-1 rounded border border-dark-lighter text-xs" title="Nur diesen Posten aus dem Entwurf nehmen.">Vom Entwurf nehmen</button>
                </form>
              )}
              {postenLoeschbar(p.herkunft, p.zustand) && (
                <form method="POST" action="/api/admin/posten" style="display:inline;" class="posten-loeschen">
                  <input type="hidden" name="postenId" value={p.id} />
                  <input type="hidden" name="aktion" value="loeschen" />
                  <button type="submit" class="px-2 py-1 rounded border border-red-400 text-red-300 text-xs" title="Falsch erfasst? Posten löschen.">Löschen</button>
                </form>
              )}
              </span>
            </td>
          </tr>
          ); })}</tbody></table>}

      </details>
    </section>

    <section id="auftraege" class="mb-8">
      <details class="liste" open>
      <summary class="liste-kopf cursor-pointer text-xs text-muted uppercase tracking-wide mb-2">Individuelle Aufträge ({auftraege.length})</summary>
      <p class="text-xs text-muted mb-2">Vorträge, Moderationen, Analysen … So geht es: 1. hier einen Auftrag mit Titel anlegen,
        2. im Auftrag „+ Neue Position mit Preis“ öffnen – erst die Positionen werden abgerechnet. Sie erscheinen nicht auf der Website.</p>
      {auftragFehler && <p role="alert" class="text-sm text-red-400 mb-2">{auftragFehler}</p>}
      {/* K129 (Handtest 29.10.2026) */}
      {q.get('angebotVerworfen') === '1' && <p class="text-sm text-green-400 mb-2">Angebotsentwurf verworfen. Der Auftrag bleibt erhalten,
        du kannst neu einen Angebotsvorschlag erstellen.</p>}
      <ZustandLegende teile={['posten', 'angebot']} />

      {/* Handtest 22.10.2026: Anlegen oberhalb der Liste – der neue Auftrag erscheint direkt darunter (neueste zuerst). */}
      <div class="mb-4">
        <form method="POST" action="/api/admin/posten" class="flex flex-col items-start gap-2">
          <input type="hidden" name="aktion" value="auftrag" />
          <input type="hidden" name="klientId" value={klient.id} />
          <input name="titel" required minlength="2" maxlength="120" placeholder="Neuer Auftrag, z. B. Moderation Strategietag" aria-label="Titel des Auftrags"
            class="w-full px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light" />
          {/* Nachtrag 24.10.2026 (K89): der Haken gehört zum Knopf und steht direkt daneben. */}
          <div class="flex flex-wrap items-center gap-3">
            <button type="submit" class="px-3 py-1.5 rounded-lg border border-gold text-gold text-sm">+ Auftrag anlegen</button>
            <label class="text-sm text-light"><input type="checkbox" name="mitAngebot" /> mit Angebot – Positionen werden erst nach Annahme des Angebotsvorschlags abrechenbar</label>
          </div>
        </form>
        <p class="text-xs text-muted mt-2">Oder einen früheren Angebotsvorschlag als Grundlage nehmen: <a class="underline" href="/admin/angebote?vorlage=1">Angebotsvorschläge → Vorlagen</a>.</p>
      </div>

      {auftraege.map((a) => {
        const pos = positionenVon(a.id);
        const summe = pos.filter((p) => p.zustand === 'offen').reduce((s, p) => Math.round((s + postenBetrag(p)) * 100) / 100, 0);
        const geplantSumme = pos.filter((p) => p.zustand === 'geplant').reduce((s, p) => Math.round((s + postenBetrag(p)) * 100) / 100, 0);
        return (
          <div id={`auftrag-${a.id}`} class="border border-dark-lighter rounded-xl p-4 mb-3">
            {/* Kopf: links Titel, rechts Umbenennen / Auftrag löschen; Umbenennen direkt im Titel (Handtest 22.10.2026). */}
            <div class="zeile flex flex-wrap items-center gap-2 mb-2 rounded px-1">
              <h3 class="ansicht text-sm font-semibold text-light">{a.titel}
                <span class="text-xs text-muted font-normal">· offen {euro(summe)}{a.modus === 'mit_angebot' && <> · in Vorbereitung {euro(geplantSumme)} · <span class="text-gold">{AUFTRAG_STAND_TEXT[a.stand ?? 'geplant']}</span></>}</span></h3>
              <span class="bearbeiten flex-1">
                <input name="titel" value={a.titel} required minlength="2" maxlength="120" form={`t-${a.id}`} aria-label="Neuer Titel" class="zfeld" />
              </span>
              <span class="ml-auto flex gap-1 text-xs">
                <span class="ansicht flex gap-1">
                  <button type="button" class="zeile-aendern px-2 py-0.5 rounded border border-gold text-gold">Umbenennen</button>
                  {auftragLoeschbar(pos.map((p) => p.zustand)) && auftragMitAngebotLoeschbar(a.stand)
                    && !angeboteVon(a.id).some((x) => x.status !== 'entwurf') && (
                    <form method="POST" action="/api/admin/posten" class="posten-loeschen" data-frage={`Auftrag „${a.titel}“ mit allen ${pos.length} Positionen löschen?`}>
                      <input type="hidden" name="aktion" value="auftrag_loeschen" />
                      <input type="hidden" name="auftragId" value={a.id} />
                      <button type="submit" class="px-2 py-0.5 rounded border border-red-400 text-red-300">Auftrag löschen</button>
                    </form>
                  )}
                </span>
                <span class="bearbeiten">
                  <form id={`t-${a.id}`} method="POST" action="/api/admin/posten" autocomplete="off" class="merk-ungespeichert inline">
                    <input type="hidden" name="aktion" value="auftrag_umbenennen" />
                    <input type="hidden" name="auftragId" value={a.id} />
                    <button type="submit" class="px-2 py-0.5 rounded bg-gold text-dark font-semibold">Speichern</button>
                  </form>
                  <button type="button" class="zeile-abbrechen px-2 py-0.5 rounded border border-dark-lighter" data-form={`t-${a.id}`}>Abbrechen</button>
                </span>
              </span>
            </div>
            {a.modus === 'mit_angebot' && (
              <div class="mb-3">
                {/* Stufe 4 T16 (K47): links anlegen – Angebot aus den geplanten Positionen. */}
                {a.stand === 'geplant' && (
                  <form method="POST" action="/api/admin/angebote" class="inline">
                    <input type="hidden" name="aktion" value="erstellen" />
                    <input type="hidden" name="klientId" value={klient.id} />
                    <input type="hidden" name="auftragId" value={a.id} />
                    <button type="submit" disabled={!pos.some((p) => p.zustand === 'geplant')}
                      title={pos.some((p) => p.zustand === 'geplant') ? 'Angebotsvorschlag aus den Positionen in Vorbereitung' : 'Zuerst mindestens eine Position anlegen'}
                      class="px-3 py-1.5 rounded-lg bg-gold text-dark text-sm font-semibold disabled:opacity-40">{angeboteVon(a.id).some((x) => x.status === 'entwurf') ? 'Angebotsentwurf öffnen' : 'Angebotsvorschlag erstellen'}</button>
                  </form>
                )}
                {angeboteVon(a.id).length > 0 && (
                  <ul class="text-xs mt-2 space-y-0.5">{angeboteVon(a.id).map((x) => (
                    <li><a class="hover:underline font-mono" href={`/admin/angebote/${x.id}`}>{x.number}</a>
                      <span class={x.stand === 'abgelaufen' ? 'text-gold' : 'text-muted'}> · {standText(x)} · {euro(x.brutto)}</span></li>))}
                  </ul>
                )}
              </div>
            )}
            {a.stand === 'angeboten' && <p class="text-xs text-gold mb-2">Angebot verschickt: Positionen sind gesperrt, bis die Antwort vermerkt ist. Änderungen über „Neue Fassung“ auf der Angebotsseite.</p>}
            <details class="mb-3" hidden={a.stand === 'angeboten'}>
              <summary class="cursor-pointer inline-block px-3 py-1.5 rounded-lg border border-gold text-gold text-sm">+ Neue Position mit Preis</summary>
            <form method="POST" action="/api/admin/posten" autocomplete="off" class="mt-2 p-3 rounded-lg border border-gold/60 bg-dark merk-ungespeichert">
              <p class="text-xs text-muted mb-2"><a href="/admin/einstellungen/regeln" class="hover:underline">Einheiten-Liste pflegen</a></p>
              <input type="hidden" name="aktion" value="position" />
              <input type="hidden" name="auftragId" value={a.id} />
              {/* Stufe 4 T15 (K46): aus der Leistungsliste vorbelegen – Werte werden kopiert und bleiben änderbar. */}
              <label class="block text-xs text-muted mb-2">Aus Leistungsliste übernehmen (freiwillig)
                <select class="leistung-uebernehmen block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light">
                  <option value="">– freie Position –</option>
                  {aktiveLeistungen.map((l) => <option data-text={l.name} data-einheit={l.einheit} data-preis={l.preis === null ? '' : String(l.preis).replace('.', ',')}>{l.name}{l.preis === null ? '' : ` – ${preisAnzeige({ preis: l.preis, nachVereinbarung: false })}`}</option>)}
                </select>
              </label>
              <div class="grid gap-2 items-end" style="grid-template-columns:repeat(auto-fit,minmax(110px,1fr));">
                <label class="text-xs text-muted">Leistungsdatum (von)
                  <input type="date" name="datum" required value={heute} class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light" />
                </label>
                <label class="text-xs text-muted">bis (nur bei Zeitraum)
                  <input type="date" name="datumBis" class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light" />
                </label>
                <label class="text-xs text-muted" style="grid-column:span 2;">Bezeichnung auf der Rechnung
                  <input name="text" required placeholder="z. B. Moderation Strategietag (ganztägig)" class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light" />
                </label>
                <label class="text-xs text-muted">Menge
                  <input name="menge" required value="1" inputmode="decimal" class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light" />
                </label>
                <label class="text-xs text-muted">Einheit
                  <select name="einheit" class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light">
                    <option value="">–</option>
                    {einheiten.map((e) => <option value={e}>{e}</option>)}
                  </select>
                </label>
                <label class="text-xs text-muted">Preis je Einheit in €
                  <input name="preis" required inputmode="decimal" placeholder="z. B. 1200" class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light" />
                </label>
              </div>
              {/* Neu-Anlegen-Knöpfe stehen links, Knöpfe für bestehende Zeilen rechts (Gerald, 22.10.2026). */}
              <button type="submit" class="mt-2 px-4 py-1.5 rounded-lg bg-gold text-dark text-sm font-semibold">Position anlegen</button>
            </form>
            </details>
            <details class="liste" open>
              <summary class="liste-kopf cursor-pointer text-xs text-muted mb-1">Positionen ({pos.length})</summary>
            {pos.length === 0 ? <p class="text-xs text-muted mb-2">Noch keine Positionen – über „+ Neue Position mit Preis“ hinzufügen.</p> : (
              <table class="w-full text-xs mb-3">
                <thead><tr class="text-left text-muted">
                  <th class="py-1 pr-2 font-normal">Datum</th><th class="py-1 pr-2 font-normal">Bezeichnung</th>
                  <th class="py-1 pr-2 font-normal text-right">Menge</th><th class="py-1 pr-2 font-normal">Einheit</th>
                  <th class="py-1 pr-2 font-normal text-right">Preis je Einheit</th>
                  <th class="py-1 pr-2 font-normal text-right">Betrag</th><th></th>
                </tr></thead>
                <tbody>{pos.map((p) => {
                  // Prüfung Stufe 4 (B1): bei verschicktem Angebot gesperrt.
                  const aenderbar = postenImEntwurfAenderbar(p.zustand) && a.stand !== 'angeboten';
                  const f = `f-${p.id}`;
                  return (
                  <tr class="zeile border-t border-dark-lighter">
                    <td class="py-1 pr-2 whitespace-nowrap align-top">
                      <span class="ansicht">{leistungszeitraum(p.datum, p.datumBis)}</span>
                      {aenderbar && <span class="bearbeiten">
                        <label class="text-muted">von<input type="date" name="datum" value={p.datum} form={f} class="zfeld" /></label>
                        <label class="text-muted">bis<input type="date" name="datumBis" value={p.datumBis ?? ''} form={f} class="zfeld" /></label>
                      </span>}
                    </td>
                    <td class="py-1 pr-2 align-top">
                      <span class="ansicht">{p.text}</span>
                      {aenderbar && <span class="bearbeiten"><input name="text" value={p.text} form={f} aria-label="Bezeichnung auf der Rechnung" class="zfeld" /></span>}
                    </td>
                    <td class="py-1 pr-2 text-right whitespace-nowrap align-top">
                      <span class="ansicht">{p.menge.toLocaleString('de-DE')}</span>
                      {aenderbar && <span class="bearbeiten"><input name="menge" value={zahlFeld(p.menge)} inputmode="decimal" form={f} aria-label="Menge" class="zfeld w-14" /></span>}
                    </td>
                    <td class="py-1 pr-2 whitespace-nowrap align-top">
                      <span class="ansicht">{p.einheit || '–'}</span>
                      {aenderbar && <span class="bearbeiten">
                        <select name="einheit" form={f} aria-label="Einheit" class="zfeld w-24">
                          <option value="" selected={!p.einheit}>–</option>
                          {einheitOptionen(p.einheit).map((e) => <option value={e} selected={e === p.einheit}>{e}</option>)}
                        </select>
                      </span>}
                    </td>
                    <td class="py-1 pr-2 text-right whitespace-nowrap align-top">
                      <span class="ansicht">{p.einzelpreis === null ? '–' : euro(p.einzelpreis)}</span>
                      {aenderbar && <span class="bearbeiten"><input name="preis" value={zahlFeld(p.einzelpreis)} inputmode="decimal" form={f} aria-label="Preis je Einheit in €" class="zfeld w-20" /></span>}
                    </td>
                    <td class="py-1 pr-2 text-right whitespace-nowrap align-top">{euro(postenBetrag(p))}</td>
                    <td class="py-1 text-right whitespace-nowrap align-top">
                      {aenderbar ? (<>
                        <span class="ansicht">
                          <button type="button" class="zeile-aendern px-2 py-0.5 rounded border border-gold text-gold">Ändern</button>
                          <form method="POST" action="/api/admin/posten" class="posten-loeschen inline" data-frage="Diese Position löschen?">
                            <input type="hidden" name="aktion" value="loeschen_auftragsposition" />
                            <input type="hidden" name="postenId" value={p.id} />
                            <button type="submit" class="px-2 py-0.5 rounded border border-red-400 text-red-300">Löschen</button>
                          </form>
                        </span>
                        <span class="bearbeiten">
                          <form id={f} method="POST" action="/api/admin/posten" autocomplete="off" class="merk-ungespeichert inline">
                            <input type="hidden" name="aktion" value="position_aendern" />
                            <input type="hidden" name="postenId" value={p.id} />
                            <button type="submit" class="px-2 py-0.5 rounded bg-gold text-dark font-semibold">Speichern</button>
                          </form>
                          <button type="button" class="zeile-abbrechen px-2 py-0.5 rounded border border-dark-lighter" data-form={f}>Abbrechen</button>
                        </span>
                      </>) : <><span class="text-muted">{ZUSTAND_TEXT[p.zustand]}</span>
                        {p.zustand === 'auf_entwurf' && p.invoiceId && (
                          <form method="POST" action="/api/admin/posten" class="posten-loeschen inline"
                            data-frage="Diesen Posten vom Rechnungsentwurf nehmen? Er bleibt als offener Posten in der Akte, der Entwurf behält die übrigen Positionen.">
                            <input type="hidden" name="aktion" value="vom_entwurf" />
                            <input type="hidden" name="postenId" value={p.id} />
                            <button type="submit" class="px-2 py-1 rounded border border-dark-lighter text-xs" title="Nur diesen Posten aus dem Entwurf nehmen.">Vom Entwurf nehmen</button>
                          </form>
                        )}
                      </>}
                    </td>
                  </tr>
                  ); })}</tbody>
              </table>
            )}
            </details>
            {/* Handtest L2 (21.10.2026): Positionsformular deutlich beschriftet, sonst als Textfeld missverstanden.
                Handtest 22.10.2026: zugeklappt, öffnet sich erst per Klick (sonst wird die Seite unnötig lang). */}
          </div>
        );
      })}

      </details>
    </section>

    {/* Stufe 4 T18 (K56): alle Angebote der Akte. */}
    <section id="angebote" class="mb-8">
      <details class="liste" open>
      <summary class="liste-kopf cursor-pointer text-xs text-muted uppercase tracking-wide mb-2">Angebotsvorschläge ({angebote.length})</summary>
      <p class="text-xs text-muted mb-2">Alle Angebotsvorschläge dieses Klienten, aktive zuerst. <a class="underline" href="/admin/angebote">Alle Angebotsvorschläge aller Klienten und Vorlagen ›</a></p>
      <ZustandLegende teile={['angebot']} />
      {angebote.length === 0 ? <p class="text-sm text-muted">Noch keine Angebotsvorschläge. Sie entstehen in einem Auftrag „mit Angebot“.</p> : (
        <table class="w-full text-sm">
          <thead><tr class="text-left text-xs text-muted"><th class="py-1 pr-3 font-normal">Nummer</th><th class="py-1 pr-3 font-normal">Auftrag</th>
            <th class="py-1 pr-3 font-normal">Datum</th><th class="py-1 pr-3 font-normal">gültig bis</th><th class="py-1 pr-3 font-normal text-right">Betrag</th><th class="py-1 pr-3 font-normal">Stand</th><th></th></tr></thead>
          <tbody>{angebote.map((x, i) => (<>
            {i === ersterAbgeschlossen && i > 0 && <tr><td colspan="7" class="pt-3 pb-1 text-xs text-muted uppercase tracking-wide">Abgeschlossen</td></tr>}
            <tr class={`border-t border-dark-lighter ${x.status === 'ersetzt' ? 'opacity-60' : ''}`}>
              <td class="py-1 pr-3 font-mono"><a class="hover:underline" href={`/admin/angebote/${x.id}`}>{x.number}</a>
                {x.vorlageName && <span class="block text-xs font-sans text-gold" title="Als Vorlage markiert">★ Vorlage: {x.vorlageName}</span>}</td>
              <td class="py-1 pr-3">{x.auftragId ? <a class="hover:underline" href={`#auftrag-${x.auftragId}`}>{x.auftragTitel ?? '–'}</a> : '–'}
                {x.status === 'angenommen' && <span class="block text-xs text-green-400">→ wurde beauftragt</span>}</td>
              <td class="py-1 pr-3">{datum(x.datum)}</td>
              <td class="py-1 pr-3">{datum(x.gueltigBis)}</td>
              <td class="py-1 pr-3 text-right">{euro(x.brutto)}</td>
              <td class={`py-1 pr-3 ${x.stand === 'abgelaufen' ? 'text-gold' : x.status === 'angenommen' ? 'text-green-400' : 'text-muted'}`}>{standText(x)}</td>
              {/* K126, K135 (Handtest 29.10.2026): Ändern und Verwerfen direkt in der Liste. */}
              <td class="py-1 text-right whitespace-nowrap">
                {x.status === 'verschickt' && <a href={`/admin/angebote/${x.id}?neueFassung=1`} class="px-2 py-1 rounded border border-gold text-gold text-xs">Ändern (neue Fassung)</a>}
                {x.status === 'entwurf' && (
                  <form method="POST" action="/api/admin/angebote" class="posten-loeschen inline" data-frage="Angebotsentwurf verwerfen? Der Auftrag und seine Positionen bleiben erhalten.">
                    <input type="hidden" name="aktion" value="verwerfen" /><input type="hidden" name="id" value={x.id} />
                    <button type="submit" class="px-2 py-1 rounded border border-red-400 text-red-300 text-xs">Verwerfen</button>
                  </form>
                )}
              </td>
            </tr></>))}
          </tbody>
        </table>
      )}
      </details>
    </section>

    <section id="termine" class="mb-8">
      <details class="liste" open>
      <summary class="liste-kopf cursor-pointer text-xs text-muted uppercase tracking-wide mb-2">Gebuchte Termine ({gebucht.length})</summary>
      <p class="text-xs text-muted mb-2">Bestätigte Buchungen. Vorbei und nicht abgesagt → wird automatisch zum offenen Posten.
        Eine Absage hier vermerken (nur für die Abrechnung, es geht keine E-Mail raus): Ausfallhonorar entsteht nur bei
        später Absage durch den Kunden oder Nichterscheinen, nie bei eigener Absage.</p>
      {gebucht.length === 0 ? <p class="text-sm text-muted">Keine bestätigten Buchungen.</p> :
        <table class="w-full text-sm"><tbody>{gebucht.map((t) => (
          <tr class={`border-t border-dark-lighter ${t.abgesagt ? 'opacity-60' : ''}`}>
            <td class="py-1 pr-3 whitespace-nowrap">{zeit(t.start)}</td>
            <td class="py-1 pr-3">{t.leistung ? (leistungsName.get(t.leistung) ?? t.leistung) : '–'}</td>
            <td class="py-1 pr-3 text-muted">
              {t.abgesagt ? `abgesagt (${ABSAGE_TEXT[t.abgesagtVon ?? 'kunde'] ?? t.abgesagtVon})${t.abgesagtAm ? ' am ' + zeit(t.abgesagtAm) : ''}`
                : (t.ende && new Date(t.ende) < new Date() ? 'stattgefunden' : 'geplant')}
            </td>
            <td class="py-1 text-right">
              {!t.abgesagt && (
                <form method="POST" action="/api/admin/posten" class="inline-flex gap-1">
                  <input type="hidden" name="aktion" value="absage" />
                  <input type="hidden" name="klientId" value={klient.id} />
                  <input type="hidden" name="terminId" value={t.id} />
                  <button type="submit" name="von" value="kunde" class="px-2 py-1 rounded border border-dark-lighter text-xs">Kunde hat abgesagt</button>
                  <button type="submit" name="von" value="gerald" class="px-2 py-1 rounded border border-dark-lighter text-xs">Ich habe abgesagt</button>
                  {t.start && new Date(t.start) < new Date() && (
                    <button type="submit" name="von" value="nicht_erschienen" class="px-2 py-1 rounded border border-dark-lighter text-xs">Nicht erschienen</button>
                  )}
                </form>
              )}
            </td>
          </tr>))}</tbody></table>}
      </details>
    </section>

    <section class="mb-8">
      <details class="liste" open>
      <summary class="liste-kopf cursor-pointer text-xs text-muted uppercase tracking-wide mb-2">Termine ({termine.length})</summary>
      {termine.length === 0 ? <p class="text-sm text-muted">Keine Termine.</p> :
        <ul class="text-sm space-y-1">{termine.map((t) => <li>{zeit(t.scheduled_at)} · {t.meeting_type} <span class="text-muted">({t.status})</span></li>)}</ul>}
      </details>
    </section>

    <section class="mb-8">
      <details class="liste" open>
      <summary class="liste-kopf cursor-pointer text-xs text-muted uppercase tracking-wide mb-2">Coaching-Sitzungen ({sitzungen.length})</summary>
      {sitzungen.length === 0 ? <p class="text-sm text-muted">Keine Sitzungen.</p> :
        <ul class="text-sm space-y-1">{sitzungen.map((s) => <li><a class="hover:underline" href={`/admin/coaching/sessions/${s.id}`}>{datum(s.created_at)} · {s.title}</a> <span class="text-muted">({s.status})</span></li>)}</ul>}
      </details>
    </section>

    <section class="mb-8">
      <details class="liste" open>
      <summary class="liste-kopf cursor-pointer text-xs text-muted uppercase tracking-wide mb-2">Rechnungen ({rechnungen.length})</summary>
      <ZustandLegende teile={['rechnung']} />
      {rechnungen.length === 0 ? <p class="text-sm text-muted">Keine Rechnungen.</p> :
        <table class="w-full text-sm"><tbody>{rechnungen.map((r) => (
          <tr class="border-t border-dark-lighter">
            <td class="py-1 pr-3 font-mono">{r.status === 'draft'
              ? <a class="text-gold underline" href={`/admin/rechnungen/entwurf/${r.id}`} title="Entwurf prüfen, ändern, verschicken">{r.number} ›</a>
              : <a class="hover:underline" href={`/admin/rechnungen/entwurf/${r.id}`} title="Rechnung öffnen: PDF, per E-Mail senden (auch erneut)">{r.number} ›</a>}</td>
            <td class="py-1 pr-3">{datum(r.issue_date)}</td>
            <td class="py-1 pr-3 text-right">{euro(r.gross_amount)}</td>
            <td class="py-1 pr-3 text-muted">{STATUS[r.status] ?? r.status}
              {r.versendet_am && <span class="block text-xs">verschickt {r.versandweg === 'post' ? 'per Post' : 'per E-Mail'} am {datum(r.versendet_am)}</span>}</td>
            <td class="py-1 text-muted">{r.empfaenger}</td>
          </tr>))}</tbody></table>}
      </details>
    </section>

    {/* Nachtrag Stufe 4 (K103): Notizen und Dokumente, auch die Nachweise zu Angeboten. */}
    <section id="notizen" class="mb-8">
      <details class="liste" open={eintraege.length > 0 || !!q.get('eintragFehler')}>
      <summary class="liste-kopf cursor-pointer text-xs text-muted uppercase tracking-wide mb-2">Notizen und Dokumente ({eintraege.length})</summary>
      {q.get('eintragGespeichert') === '1' && <p class="text-sm text-green-400 mb-2">Gespeichert.</p>}
      {q.get('eintragFehler') && <p role="alert" class="text-sm text-red-400 mb-2">{q.get('eintragFehler')}</p>}
      <AkteEintraege eintraege={eintraege} klientId={klient.id} zurueck={`/admin/klienten/${klient.id}`} />
      </details>
    </section>

    {/* Änderungsprotokoll (K96): die letzten Einträge zu diesem Klienten, zugeklappt. */}
    <section id="protokoll" class="mb-8">
      <details class="liste">
      <summary class="liste-kopf cursor-pointer text-xs text-muted uppercase tracking-wide mb-2">Änderungsprotokoll (letzte {protokoll.zeilen.length}{protokoll.mehr ? '+' : ''})</summary>
      <p class="text-xs text-muted mb-2">Wer hat wann was an dieser Akte geändert. <a class="underline" href={`/admin/protokoll?klient=${klient.id}`}>Alle Einträge zu {klient.name} ›</a></p>
      <ProtokollTabelle zeilen={protokoll.zeilen} />
      </details>
    </section>

    {/* Rückfrage auf der Seite statt Browser-Fenster. */}
    <div id="rueckfrage" hidden class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4">
      <div class="bg-surface border border-gold/60 rounded-xl p-5 max-w-md w-full shadow-xl">
        <p id="rueckfrage-text" class="text-sm text-light mb-4"></p>
        <div class="flex gap-2 justify-end">
          <button type="button" id="rueckfrage-nein" class="px-3 py-2 rounded-lg border border-dark-lighter text-sm">Abbrechen</button>
          <button type="button" id="rueckfrage-ja" class="px-3 py-2 rounded-lg bg-gold text-dark text-sm font-semibold">Ja</button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  /* Kalender-Symbol auf dunklem Grund sichtbar (Handtest 21.10.2026). */
  input[type='date'] { color-scheme: dark; cursor: pointer; }
  /* Ändern direkt in der Zeile (Handtest 22.10.2026): „ansicht“ und „bearbeiten“ wechseln,
     die Zeile in Bearbeitung ist gold hinterlegt, damit klar ist, welche man ändert. */
  .zeile .bearbeiten { display: none; }
  .zeile.im-bearbeiten .ansicht { display: none; }
  .zeile.im-bearbeiten .bearbeiten { display: block; }
  .zeile.im-bearbeiten td .bearbeiten, .zeile.im-bearbeiten > .bearbeiten { display: block; }
  .zeile.im-bearbeiten { background: var(--color-gold-dim, rgba(200, 170, 90, 0.14)); outline: 1px solid var(--color-gold, #c9a227); }
  .zfeld { display: block; width: 100%; min-width: 0; margin: 0.125rem 0; padding: 0.2rem 0.4rem; border-radius: 0.25rem; font-size: 0.8rem;
    background: var(--color-dark, #111); border: 1px solid var(--color-dark-lighter, #333); color: var(--color-light, #eee); }
  .zfeld.w-14 { width: 3.5rem; } .zfeld.w-20 { width: 5rem; } .zfeld.w-24 { width: 6rem; }
  .inline-flex > .zfeld { display: inline-block; }
  /* „Rechnung erstellen“: Häkchen kurz hervorheben */
  input.rechnung-wahl.hervorheben { outline: 2px solid var(--color-gold, #c9a227); outline-offset: 2px; }
  /* K127 (Handtest 29.10.2026): angelegter Rechnungsentwurf, deutlich und mit Knopf. */
  .entwurf-hinweis { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between;
    padding: 0.6rem 0.9rem; border: 1px solid var(--color-gold, #c9a227); background: rgba(201, 162, 39, 0.12); border-radius: 0.75rem; font-size: 0.875rem; }
</style>

<script>
  // Datum: Klick ins Feld öffnet den Kalender, nicht nur das kleine Symbol.
  document.querySelectorAll<HTMLInputElement>('input[type="date"]').forEach((d) => {
    d.addEventListener('click', () => { try { d.showPicker(); } catch { /* ältere Browser: Symbol bleibt */ } });
  });
  // Zeitraum: „bis“ bietet keine Tage vor „von“ an (geprüft wird zusätzlich auf dem Server).
  document.querySelectorAll<HTMLInputElement>('input[name="datumBis"]').forEach((bis) => {
    // Felder in Tabellenzeilen gehören über das form-Attribut zum Formular, daher elements statt querySelector.
    const von = bis.form?.elements.namedItem('datum') as HTMLInputElement | null;
    const setze = () => { if (von) bis.min = von.value; };
    setze();
    von?.addEventListener('change', setze);
  });

  // Sitzung erfassen: Preis und Rechnungstext der gewählten Leistung vorbelegen (änderbar).
  const leistungWahl = document.getElementById('sitzung-leistung') as HTMLSelectElement | null;
  const preisFeld = document.getElementById('sitzung-preis') as HTMLInputElement | null;
  const textFeld = document.getElementById('sitzung-text') as HTMLInputElement | null;
  leistungWahl?.addEventListener('change', () => {
    const opt = leistungWahl.selectedOptions[0];
    if (preisFeld) preisFeld.value = opt?.dataset.preis ?? '';
    if (textFeld) textFeld.value = opt?.dataset.text ?? '';
  });

  // Warnung vor ungespeicherten Eingaben (Handtest L2: Positionen wurden ausgefüllt, aber
  // mit dem Stammdaten-Knopf weiter unten „gespeichert“ – und gingen verloren).
  // Felder in Tabellenzeilen stehen außerhalb ihres Formulars (form-Attribut), daher über .form zuordnen.
  const ungespeichert = new Set<HTMLFormElement>();
  document.addEventListener('input', (e) => {
    const f = (e.target as HTMLInputElement).form;
    if (f?.classList.contains('merk-ungespeichert')) ungespeichert.add(f);
  });
  document.querySelectorAll<HTMLFormElement>('form.merk-ungespeichert').forEach((f) => {
    f.addEventListener('submit', () => ungespeichert.delete(f));
  });
  window.addEventListener('beforeunload', (e) => {
    if (ungespeichert.size > 0) { e.preventDefault(); e.returnValue = ''; }
  });

  // Ändern direkt in der Zeile: „Ändern“ schaltet die Zeile um, „Abbrechen“ setzt die Werte zurück.
  document.querySelectorAll<HTMLButtonElement>('.zeile-aendern').forEach((b) => {
    b.addEventListener('click', () => {
      const z = b.closest('.zeile');
      z?.classList.add('im-bearbeiten');
      z?.querySelector<HTMLInputElement>('.bearbeiten input:not([type="hidden"]):not([type="date"])')?.focus();
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.zeile-abbrechen').forEach((b) => {
    b.addEventListener('click', () => {
      const f = document.getElementById(b.dataset.form ?? '') as HTMLFormElement | null;
      if (f) { f.reset(); ungespeichert.delete(f); }
      b.closest('.zeile')?.classList.remove('im-bearbeiten');
    });
  });

  // T10a: Rechnung aus Auswahl – Knopf erst aktiv, wenn etwas angekreuzt ist; Summe anzeigen.
  const wahl = [...document.querySelectorAll<HTMLInputElement>('input.rechnung-wahl')];
  const rechnungKnopf = document.getElementById('rechnung-erstellen') as HTMLButtonElement | null;
  const rechnungSumme = document.getElementById('rechnung-summe');
  const zeigeAuswahl = () => {
    const an = wahl.filter((c) => c.checked);
    const summe = an.reduce((s, c) => s + Number(c.dataset.betrag ?? 0), 0);
    if (rechnungKnopf) rechnungKnopf.disabled = an.length === 0;
    if (rechnungSumme) rechnungSumme.textContent = an.length === 0
      ? 'Posten ankreuzen, die auf die Rechnung sollen.'
      : `${an.length} Posten · ${summe.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' })}`;
  };
  wahl.forEach((c) => c.addEventListener('change', zeigeAuswahl));
  document.getElementById('rechnung-alle')?.addEventListener('click', () => {
    const alle = wahl.every((c) => c.checked);
    wahl.forEach((c) => { c.checked = !alle; });
    zeigeAuswahl();
  });

  // Alle Listen auf-/zuklappen (nur die Listen, nicht Stammdaten und Anlegen-Formulare).
  const listen = () => document.querySelectorAll<HTMLDetailsElement>('details.liste');
  document.getElementById('listen-auf')?.addEventListener('click', () => listen().forEach((d) => { d.open = true; }));
  document.getElementById('listen-zu')?.addEventListener('click', () => listen().forEach((d) => { d.open = false; }));

  // „Rechnung erstellen“ im Kopf: Abrechnung aufklappen, hinscrollen, Häkchen kurz hervorheben.
  // Stufe 4 T19: ?rechnung=1 (aus Fakturierung → Neue Rechnung) löst dasselbe beim Öffnen aus.
  const sprung = document.getElementById('rechnung-erstellen-sprung');
  if (new URLSearchParams(location.search).get('rechnung') === '1') setTimeout(() => sprung?.click(), 50);
  sprung?.addEventListener('click', (e) => {
    e.preventDefault();
    const bereich = document.getElementById('abrechnung');
    bereich?.querySelectorAll<HTMLDetailsElement>('details.liste').forEach((d) => { d.open = true; });
    bereich?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (rechnungSumme) {
      rechnungSumme.textContent = wahl.length === 0
        ? 'Keine offenen Posten mit Preis. Zuerst über „+ Sitzung erfassen“ oder einen Auftrag anlegen.'
        : 'Posten ankreuzen, die auf die Rechnung sollen, dann „Rechnung aus Auswahl erstellen“.';
    }
    const hinweis = document.getElementById('rechnung-hinweis-leer');
    if (wahl.length === 0 && hinweis) hinweis.hidden = false;
    wahl.forEach((c) => c.classList.add('hervorheben'));
    setTimeout(() => wahl.forEach((c) => c.classList.remove('hervorheben')), 2500);
  });

  // Stufe 4 T15: Position aus der Leistungsliste vorbelegen (Bezeichnung, Einheit, Preis).
  document.querySelectorAll<HTMLSelectElement>('select.leistung-uebernehmen').forEach((wahl) => {
    wahl.addEventListener('change', () => {
      const o = wahl.selectedOptions[0];
      const f = wahl.form;
      if (!o || !f || !o.dataset.text) return;
      const feld = (n: string) => f.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement | null;
      const t = feld('text'); if (t) t.value = o.dataset.text ?? '';
      const p = feld('preis'); if (p) p.value = o.dataset.preis ?? '';
      const e = feld('einheit') as HTMLSelectElement | null;
      if (e && o.dataset.einheit) {
        if (![...e.options].some((x) => x.value === o.dataset.einheit)) e.add(new Option(o.dataset.einheit, o.dataset.einheit));
        e.value = o.dataset.einheit;
      }
    });
  });

  // Rückfrage auf der Seite statt Browser-Fenster (wie Rechnungs- und Angebotsseite).
  function frage(text: string, ja = 'Ja'): Promise<boolean> {
    const box = document.getElementById('rueckfrage') as HTMLElement;
    const jaK = document.getElementById('rueckfrage-ja') as HTMLButtonElement;
    const neinK = document.getElementById('rueckfrage-nein') as HTMLButtonElement;
    (document.getElementById('rueckfrage-text') as HTMLElement).textContent = text;
    jaK.textContent = ja;
    box.hidden = false;
    return new Promise((fertig) => {
      const zu = (w: boolean) => { box.hidden = true; jaK.onclick = null; neinK.onclick = null; fertig(w); };
      jaK.onclick = () => zu(true);
      neinK.onclick = () => zu(false);
    });
  }
  // Löschen, Zurückziehen u. Ä. nur nach Rückfrage.
  document.querySelectorAll<HTMLFormElement>('form.posten-loeschen, form.mit-rueckfrage').forEach((f) => {
    f.addEventListener('submit', async (e) => {
      if (f.dataset.bestaetigt === '1') return;
      e.preventDefault();
      if (await frage(f.dataset.frage ?? 'Diesen Posten wirklich löschen?', f.dataset.ja ?? 'Ja')) { f.dataset.bestaetigt = '1'; f.requestSubmit(); }
    });
  });

  const knopf = document.getElementById('konto-einrichten') as HTMLButtonElement | null;
  const meldung = document.getElementById('konto-meldung');
  knopf?.addEventListener('click', async () => {
    if (!(await frage('Benutzerkonto anlegen und Einladung per E-Mail an den Klienten senden?', 'Konto anlegen'))) return;
    knopf.disabled = true;
    const res = await fetch('/api/admin/clients/enroll', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ customerId: knopf.dataset.id }),
    });
    const data = await res.json().catch(() => ({}));
    if (meldung) {
      meldung.textContent = res.ok ? 'Konto angelegt, Einladung verschickt.' : (data.error ?? 'Konto konnte nicht angelegt werden.');
      meldung.className = 'text-sm mb-4 ' + (res.ok ? 'text-green-400' : 'text-red-400');
    }
    if (res.ok) setTimeout(() => location.reload(), 1200); else knopf.disabled = false;
  });
</script>
