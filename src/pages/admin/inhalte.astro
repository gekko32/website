---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/ui/AdminPageHeader.svelte';
import InhalteEditor from '../../components/admin/InhalteEditor.svelte';
import { getSession, getLoginUrl, isAdmin } from '../../lib/auth';
import { getEffectiveHomepage, getEffectiveUebermich, getEffectiveServices, getEffectiveLeistungen, getPriceListUrl, getEffectiveFaq, getEffectiveKontakt, getEffectiveReferenzen, getEffectiveStammdaten, getEffectiveNavigation, getEffectiveFooter, getEffectiveKoreFlags } from '../../lib/content';
import { getLegalPage, listCustomSections, getSiteSetting, readContent } from '../../lib/website-db';
import { getDefaultDatenschutz, getDefaultAgb, getDefaultBarrierefreiheit, getDefaultImpressumZusatz } from '../../lib/legal-defaults';
import { config } from '../../config/index';
import type { HomepageService, ServicePageContent, LeistungCategory, LeistungService } from '../../config/types';
import { RECHNUNGSTEXT_STANDARD } from '../../lib/billing-rechnungstexte';
import { readMainContent } from '../../lib/content-publish';
import { bundleAuftritt, bundleGeschichten } from '../../lib/content-bundle';
import type { Domain } from '../../content-schema';

type EditorService = HomepageService & { hidden?: boolean; meta?: string; leistungCategoryId?: string };

const session = await getSession(Astro.request.headers.get('cookie'));
if (!session) return Astro.redirect(getLoginUrl(Astro.url.pathname));
if (!isAdmin(session)) return Astro.redirect('/admin');

const BRAND = import.meta.env.BRAND || process.env.BRAND || 'mentolder';

function serviceToEditorData(svc: EditorService | undefined) {
  const pc: Partial<ServicePageContent> = svc?.pageContent ?? {};
  const introNoteSection = (pc.sections ?? []).find((s) => s.title === '__introNote__');
  const introNote = introNoteSection?.items?.join('\n\n') ?? '';
  const visibleSections = (pc.sections ?? []).filter((s) => s.title !== '__introNote__');
  return {
    cardTitle: svc?.title ?? '',
    cardDescription: svc?.description ?? '',
    cardPrice: svc?.price ?? '',
    cardIcon: svc?.icon ?? '',
    cardFeatures: svc?.features ?? [],
    headline: pc.headline ?? '',
    intro: pc.intro ?? '',
    introNote,
    forWhom: pc.forWhom ?? [],
    sections: visibleSections,
    pricing: pc.pricing ?? [],
    faq: pc.faq ?? [],
    ctaText: pc.pricing?.[0]?.label ?? 'Kostenloses Erstgespräch buchen',
    ctaHref: '/termin',
    seoTitle: pc.seoTitle ?? '',
    seoDescription: pc.seoDescription ?? svc?.description ?? '',
    isCatalogLinked: !!svc?.leistungCategoryId,
    catalogTiers: (svc?.leistungCategoryId
      ? leistungen.find((c: LeistungCategory) => c.id === svc?.leistungCategoryId)?.services?.map((r: LeistungService) => ({
          label: r.name ?? '', price: r.price ?? '', unit: r.unit ?? '', highlight: r.highlight ?? false,
        })) ?? []
      : []),
  };
}

const allServices = await getEffectiveServices();

const [startseite, uebermich, leistungen, priceListUrl, faq, kontakt, referenzen, coachingContent, fuehrungContent,
  dbImpressum, dbDatenschutz, dbAgb, dbBarrierefreiheit, customSections,
  stammdaten, navigation, footer, koreFlags] = await Promise.all([
  getEffectiveHomepage(), getEffectiveUebermich(), getEffectiveLeistungen(),
  getPriceListUrl().then(u => u ?? ''), getEffectiveFaq(), getEffectiveKontakt(), getEffectiveReferenzen(),
  readContent(BRAND, 'service:coaching').catch(() => ({ value: null, version: 0 })),
  readContent(BRAND, 'service:fuehrung-persoenlichkeit').catch(() => ({ value: null, version: 0 })),
  getLegalPage(BRAND, 'impressum-zusatz'),
  getLegalPage(BRAND, 'datenschutz'),
  getLegalPage(BRAND, 'agb'),
  getLegalPage(BRAND, 'barrierefreiheit'),
  listCustomSections(),
  getEffectiveStammdaten(), getEffectiveNavigation(), getEffectiveFooter(), getEffectiveKoreFlags(),
]);

// Rechtliches: DB-Wert wenn vorhanden, sonst Standardtext als Vorschau
// Das Admin-Feld zeigt den echten Inhalt – nie leer.
const rechtliches = {
  'impressum-zusatz': dbImpressum ?? getDefaultImpressumZusatz(),
  'datenschutz':      dbDatenschutz ?? getDefaultDatenschutz(),
  'agb':              dbAgb ?? getDefaultAgb(),
  'barrierefreiheit': dbBarrierefreiheit ?? getDefaultBarrierefreiheit(),
};
// Flag: welche Felder sind echte DB-Werte (true) vs. Standardtext-Vorschau (false)
const rechtlichesHasCustom = {
  'impressum-zusatz': dbImpressum !== null,
  'datenschutz':      dbDatenschutz !== null,
  'agb':              dbAgb !== null,
  'barrierefreiheit': dbBarrierefreiheit !== null,
};

// mentolder-Auftritt (SPEZ-NEUER-AUFTRITT K199–K207): Formulare starten vom neuesten Stand in main und schicken
// dessen Blob-SHA beim Speichern mit. Ohne GitHub-Zugang (lokal) gilt das ausgelieferte Bundle, ohne Abgleich.
async function vomHauptstand<T>(domain: Domain, fallback: T): Promise<{ value: T; baseSha: string | null }> {
  try {
    const r = await readMainContent(BRAND, domain);
    return { value: r.value as T, baseSha: r.sha };
  } catch {
    return { value: fallback, baseSha: null };
  }
}
const isMentolder = BRAND === 'mentolder';
const auftrittData = isMentolder ? await vomHauptstand('auftritt', bundleAuftritt(BRAND)) : null;
const geschichtenData = isMentolder ? await vomHauptstand('geschichten', bundleGeschichten(BRAND)) : null;
const BEREICH_SLUGS = ['selbststaendige-vereine', 'kleine-unternehmen', 'verwaltung', 'fuehrung-persoenlichkeit'];
const bereiche = isMentolder
  ? Object.fromEntries(BEREICH_SLUGS.map((slug) => [`bereich:${slug}`, serviceToEditorData(allServices.find((s) => s.slug === slug))]))
  : {};

const svc50plus     = allServices.find(s => s.slug === '50plus-digital');
const svcKiTransition = allServices.find(s => s.slug === 'ki-transition');
const svcBeratung   = allServices.find(s => s.slug === 'beratung');

const RECHNUNG_KEYS = ['invoice_intro_text','invoice_kleinunternehmer_notice','invoice_outro_text','invoice_email_subject','invoice_email_body'] as const;
// Standardtexte an einer Stelle (billing-rechnungstexte); gepflegt auch unter Einstellungen → Rechnungstexte.
const RECHNUNG_DEFAULTS: Record<typeof RECHNUNG_KEYS[number], string> = RECHNUNGSTEXT_STANDARD;
const rechnungsResults = await Promise.all(RECHNUNG_KEYS.map(k => getSiteSetting(BRAND, k)));
const rechnungsvorlagen = Object.fromEntries(RECHNUNG_KEYS.map((k, i) => [k, rechnungsResults[i] ?? RECHNUNG_DEFAULTS[k]])) as Record<typeof RECHNUNG_KEYS[number], string>;

const initialData = JSON.parse(JSON.stringify({
  startseite, uebermich,
  services: allServices,
  leistungen, priceListUrl, faq, kontakt, referenzen,
  coaching: { value: coachingContent.value, version: coachingContent.version },
  fuehrung: { value: fuehrungContent.value, version: fuehrungContent.version },
  '50plus-digital': serviceToEditorData(svc50plus),
  'ki-transition':  serviceToEditorData(svcKiTransition),
  'beratung':       serviceToEditorData(svcBeratung),
  rechtliches,
  rechtlichesHasCustom,
  customSections,
  navigation, footer, stammdaten, koreFlags,
  auftritt: auftrittData, geschichten: geschichtenData, bereiche,
}));
---

<AdminLayout title="Admin — Inhalte">
  <section class="pt-0 pb-0 bg-dark min-h-screen">
    <div class="px-8 pt-8 mb-2">
<AdminPageHeader title="Inhalte" />
    </div>
    <InhalteEditor {initialData} {rechnungsvorlagen} brand={BRAND} staticServiceSlugs={config.services.map(s => s.slug)} client:load />
  </section>
</AdminLayout>
