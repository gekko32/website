---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/ui/AdminPageHeader.svelte';
import AdminTabs from '../../components/admin/ui/AdminTabs.svelte';
import { getSession, getLoginUrl, isAdmin } from '../../lib/auth';
import { getAllBillingInvoices, getDraftInvoices } from '../../lib/stripe-billing';
import { verbucheUndEntwerfe } from '../../lib/billing-abrechnungslauf';
import { offeneAngebote, ANGEBOT_STAND_TEXT } from '../../lib/billing-angebot';
import { listPendingDunnings, type PendingDunning } from '../../lib/invoice-dunning';
import type { AdminBillingInvoice } from '../../lib/stripe-billing';
import TaxMonitorWidget from '../../components/admin/TaxMonitorWidget.svelte';
import DatevExportWidget from '../../components/admin/DatevExportWidget.svelte';
import { listKlienten } from '../../lib/klientenakte';
import { anzeigeEmail } from '../../lib/billing-versand';
import { logger } from '../../lib/logger';

const session = await getSession(Astro.request.headers.get('cookie'));
if (!session) return Astro.redirect(getLoginUrl(Astro.url.pathname));
// Stufe 3 T4: Auswahl aus der gepflegten Leistungstabelle.
// Stufe 4 T19 (K66): Neue Rechnung = Klient wählen → dessen offene Posten in der Akte.
const klientenWahl = await listKlienten().catch(() => []);
if (!isAdmin(session)) return Astro.redirect('/admin');

const statusFilter = Astro.url.searchParams.get('status') ?? '';

let invoices: AdminBillingInvoice[] = [];
let pendingDunnings: PendingDunning[] = [];
let apiError = '';
const brand = process.env.BRAND || 'mentolder';

if (statusFilter === 'mahnwesen') {
  try {
    pendingDunnings = await listPendingDunnings(brand);
  } catch (err) {
    logger.error({ err }, '[admin/rechnungen] listPendingDunnings');
    apiError = 'Mahnwesen konnte nicht geladen werden.';
  }
} else {
  try {
    invoices = await getAllBillingInvoices({ status: statusFilter || undefined, perPage: 200 });
  } catch (err) {
    logger.error({ err }, '[admin/rechnungen]');
    apiError = 'Datenbank nicht erreichbar.';
  }
}

let draftInvoices: Awaited<ReturnType<typeof getDraftInvoices>> = [];
let offeneAngebotListe: Awaited<ReturnType<typeof offeneAngebote>> = [];
try {
  // Prüfung L3 (B4): Entwürfe „je Sitzung“ auch beim Öffnen der Rechnungen anlegen (K27).
  await verbucheUndEntwerfe(process.env.BRAND || 'mentolder').catch(() => {});
  draftInvoices = await getDraftInvoices();
  // Stufe 4 T18 (K57): verschickte, unbeantwortete Angebote.
  offeneAngebotListe = await offeneAngebote(process.env.BRAND || 'mentolder').catch(() => []);
} catch (err) {
  logger.error({ err }, '[admin/rechnungen] getDraftInvoices');
}

const today = new Date().toISOString().slice(0, 10);
const totalOpen       = invoices.filter(i => i.amountRemaining > 0 && !['void','uncollectible'].includes(i.status)).reduce((s, i) => s + i.amountRemaining, 0);
const totalPaid       = invoices.filter(i => i.status === 'paid').reduce((s, i) => s + i.amountPaid, 0);
const countOverdue    = invoices.filter(i => i.status === 'open' && i.dueDate < today).length;

function fmtCurrency(n: number): string {
  return new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(n);
}
function fmtDate(s: string): string {
  if (!s) return '—';
  return new Date(s).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

const STATUS_CLS: Record<string, string> = {
  'draft':          'bg-slate-900/40 text-slate-300 border-slate-700',
  'open':           'bg-blue-900/40 text-blue-300 border-blue-800',
  'partially_paid': 'bg-yellow-900/40 text-yellow-300 border-yellow-800',
  'paid':           'bg-green-900/40 text-green-300 border-green-800',
  'void':           'bg-dark border border-dark-lighter text-muted',
  'uncollectible':  'bg-red-900/40 text-red-300 border-red-800',
};

const billingTabs = [
  { id: '/admin/rechnungen',    label: 'Rechnungen',    href: '/admin/rechnungen' },
  { id: '/admin/zeiterfassung', label: 'Zeiterfassung', href: '/admin/zeiterfassung' },
];

const STATUS_TABS = [
  { value: '',               label: 'Alle' },
  { value: 'open',           label: 'Offen' },
  { value: 'partially_paid', label: 'Teilbezahlt' },
  { value: 'uncollectible',  label: 'Überfällig' },
  { value: 'paid',           label: 'Bezahlt' },
  { value: 'mahnwesen',      label: 'Mahnwesen' },
  { value: 'draft',          label: 'Entwurf' },
  { value: 'void',           label: 'Storniert' },
];
---

<AdminLayout title="Admin — Rechnungen">
  <div style="border-bottom:1px solid var(--line);padding:0 2rem;flex-shrink:0;">
    <AdminTabs tabs={billingTabs} active="/admin/rechnungen" client:load />
  </div>
  <section class="pt-10 pb-20 bg-dark min-h-screen">
    <div class="max-w-6xl mx-auto px-6">

      <TaxMonitorWidget client:load />
      <DatevExportWidget client:load />

      <div class="mb-8 flex items-start justify-between gap-4">
        <AdminPageHeader
          title="Fakturierung"
          description={`${invoices.length} Rechnungen über alle Clients`}
        />
        {/* Stufe 4 T19 (K66, K67): keine Rechnungen ohne Akte; altes Feld „Angebot“ entfällt. */}
        <details class="relative">
          <summary class="cursor-pointer list-none px-4 py-2 rounded-lg bg-gold text-dark text-sm font-semibold">+ Neue Rechnung</summary>
          <div class="absolute right-0 z-20 mt-2 w-80 bg-surface border border-border rounded-xl p-3 shadow-xl">
            <p class="text-xs text-muted mb-2">Für wen? Danach wählst du in der Akte die offenen Posten.</p>
            <input id="klient-wahl-suche" type="search" placeholder="Name, Nummer, E-Mail …" class="w-full mb-2 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light" />
            <ul class="max-h-64 overflow-y-auto text-sm">
              {klientenWahl.map((k) => (
                <li class="klient-wahl" data-suche={`${k.name} ${k.customer_number ?? ''} ${anzeigeEmail(k.email)} ${k.rechnung_firma ?? ''}`.toLowerCase()}>
                  <a class="block px-2 py-1 rounded hover:bg-dark-lighter" href={`/admin/klienten/${k.id}?rechnung=1#abrechnung`}>{k.name}
                    <span class="text-xs text-muted">{k.customer_number ?? ''}{k.rechnung_firma ? ` · ${k.rechnung_firma}` : ''}</span></a>
                </li>))}
            </ul>
            <a href="/admin/klienten" class="block mt-2 text-xs text-gold hover:underline">+ Neuer Klient (Akte anlegen)</a>
          </div>
        </details>
      </div>

      <!-- KPI Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
        {[
          { label: 'Offen',      value: fmtCurrency(totalOpen),  cls: totalOpen > 0 ? 'border-yellow-800' : 'border-dark-lighter' },
          { label: 'Bezahlt',    value: fmtCurrency(totalPaid),  cls: 'border-green-800' },
          { label: 'Überfällig', value: countOverdue,            cls: countOverdue > 0 ? 'border-red-800' : 'border-dark-lighter' },
          { label: 'Gesamt',     value: invoices.length,         cls: 'border-dark-lighter' },
        ].map(s => (
          <div class={`p-4 bg-dark-light rounded-xl border ${s.cls}`}>
            <div class="text-xl font-bold text-light">{s.value}</div>
            <div class="text-xs text-muted mt-0.5">{s.label}</div>
          </div>
        ))}
      </div>

      {apiError && (
        <div class="mb-6 p-4 bg-red-900/30 border border-red-800 rounded-xl text-red-300 text-sm">{apiError}</div>
      )}

      <!-- Stufe 4 T18 (K57): offene Angebote, abgelaufene hervorgehoben -->
      {offeneAngebotListe.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold text-light mb-4">Angebote mit offener Antwort
            <span class="ml-2 text-sm font-normal text-muted">({offeneAngebotListe.length})</span></h2>
          <div class="space-y-2">
            {offeneAngebotListe.map((x) => (
              <a href={`/admin/angebote/${x.id}`} class={`flex flex-wrap items-center justify-between gap-2 bg-surface border rounded-xl p-3 hover:border-gold ${x.stand === 'abgelaufen' ? 'border-gold' : 'border-border'}`}>
                <span><span class="font-mono text-sm">{x.number}</span> <span class="text-light">{x.klientName}</span> <span class="text-muted text-sm">· {x.auftragTitel}</span></span>
                <span class={`text-sm ${x.stand === 'abgelaufen' ? 'text-gold font-semibold' : 'text-muted'}`}>
                  {x.brutto.toFixed(2).replace('.', ',')} € · gültig bis {x.gueltigBis.split('-').reverse().join('.')} · {ANGEBOT_STAND_TEXT[x.stand]}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Draft Invoice Section -->
      {draftInvoices.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold text-light mb-4">
            Rechnungsentwürfe (noch nicht verschickt)
            <span class="ml-2 text-sm font-normal text-muted">({draftInvoices.length})</span>
          </h2>
          <div class="space-y-3" id="draft-list">
            {draftInvoices.map(inv => (
              <div
                class="bg-surface border border-border rounded-xl p-4 flex items-center justify-between gap-4"
                data-invoice-id={inv.id}
              >
                <div>
                  <p class="font-semibold text-light">{inv.customerName} <span class="text-xs font-mono text-muted">{inv.number}</span></p>
                  <p class="text-sm text-muted">{inv.customerEmail}</p>
                  <p class="text-sm text-muted mt-1">
                    Betrag: <span class="text-light font-medium">
                      {inv.amountDue.toFixed(2).replace('.', ',') + ' €'}
                    </span>
                  </p>
                </div>
                <div class="flex gap-2 flex-shrink-0">
                  <button class="open-draft-btn px-3 py-1.5 text-sm bg-surface-hover border border-border rounded-lg hover:border-gold transition-colors" data-id={inv.id}>Prüfen</button>
                  <button class="discard-draft-btn px-3 py-1.5 text-sm text-red-400 border border-border rounded-lg hover:border-red-400 transition-colors" data-id={inv.id}>Verwerfen</button>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Status filter tabs -->
      <div class="flex gap-1 p-1 bg-dark-light rounded-lg border border-dark-lighter mb-6 w-fit flex-wrap">
        {STATUS_TABS.map(t => (
          <a href={`/admin/rechnungen${t.value ? '?status=' + t.value : ''}`}
            class={`px-3 py-1.5 rounded text-sm font-medium transition-colors ${statusFilter === t.value ? 'bg-gold text-dark' : 'text-muted hover:text-light'}`}>
            {t.label}
          </a>
        ))}
      </div>

      <!-- Table -->
      <div class="bg-dark-light rounded-2xl border border-dark-lighter overflow-hidden">
        <table class="w-full admin-table-collapse">
          <thead>
            <tr class="border-b border-dark-lighter">
              <th class="text-left px-4 py-3 text-xs text-muted uppercase tracking-wide font-medium">Nr.</th>
              <th class="text-left px-4 py-3 text-xs text-muted uppercase tracking-wide font-medium">Client</th>
              <th class="text-left px-4 py-3 text-xs text-muted uppercase tracking-wide font-medium">Status</th>
              <th class="text-left px-4 py-3 text-xs text-muted uppercase tracking-wide font-medium">Datum</th>
              <th class="text-left px-4 py-3 text-xs text-muted uppercase tracking-wide font-medium">Fällig</th>
              <th class="text-right px-4 py-3 text-xs text-muted uppercase tracking-wide font-medium">Betrag</th>
              <th class="text-right px-4 py-3 text-xs text-muted uppercase tracking-wide font-medium">Offen</th>
              <th class="text-right px-4 py-3 text-xs text-muted uppercase tracking-wide font-medium">E-Rechnung</th>
              <th class="text-right px-4 py-3 text-xs text-muted uppercase tracking-wide font-medium">Drucken</th>
            </tr>
          </thead>
          <tbody>
            {statusFilter === 'mahnwesen' ? (
              pendingDunnings.length === 0 ? (
                <tr>
                  <td colspan="9" class="px-4 py-10 text-center text-muted text-sm">Keine ausstehenden Mahnungen.</td>
                </tr>
              ) : pendingDunnings.map(d => (
                <tr class="border-b border-dark-lighter/50 hover:bg-dark/30 transition-colors">
                  <td class="px-4 py-3 text-sm text-light font-mono" data-label="Nr.">#{d.invoiceNumber}</td>
                  <td class="px-4 py-3 text-sm" data-label="Client">
                    <div class="text-light">{d.customerName}</div>
                    <div class="text-xs text-muted">{d.customerEmail}</div>
                  </td>
                  <td class="px-4 py-3" data-label="Status">
                    <span class="text-xs px-2 py-0.5 rounded-full border border-red-800 bg-red-900/40 text-red-300">
                      Mahnung {d.level}
                    </span>
                  </td>
                  <td class="px-4 py-3 text-sm text-muted" data-label="Datum">Ausstehend</td>
                  <td class="px-4 py-3 text-sm text-red-400 font-medium" data-label="Fällig">SOFORT</td>
                  <td class="px-4 py-3 text-sm text-light text-right font-medium" data-label="Betrag">
                    {fmtCurrency(d.outstanding + d.feeAmount + d.interestAmount)}
                  </td>
                  <td class="px-4 py-3 text-sm text-right text-yellow-400 font-medium" data-label="Offen">{fmtCurrency(d.outstanding)}</td>
                  <td class="px-4 py-3 text-sm text-right" data-label="E-Rechnung">—</td>
                  <td class="px-4 py-3 text-sm text-right" data-label="Drucken">
                    <button
                      class="text-xs text-yellow-400 hover:underline"
                      data-send-dunning
                      data-id={d.id}
                      data-level={d.level}
                    >Versenden ↑</button>
                  </td>
                </tr>
              ))
            ) : (
              invoices.length === 0 ? (
                <tr>
                  <td colspan="9" class="px-4 py-10 text-center text-muted text-sm">Keine Rechnungen gefunden.</td>
                </tr>
              ) : invoices.map(inv => (
              <tr class="border-b border-dark-lighter/50 hover:bg-dark/30 transition-colors">
                <td class="px-4 py-3 text-sm text-light font-mono" data-label="Nr.">#{inv.number}</td>
                <td class="px-4 py-3 text-sm" data-label="Client">
                  <div class="text-light">{inv.customerName}</div>
                  <div class="text-xs text-muted">{inv.customerEmail}</div>
                </td>
                <td class="px-4 py-3" data-label="Status">
                  <span class={`text-xs px-2 py-0.5 rounded-full border whitespace-nowrap ${STATUS_CLS[inv.status] ?? ''}`}>
                    {inv.statusLabel}
                  </span>
                  {inv.versandVermerk && <div class="text-xs text-muted mt-1">{inv.versandVermerk}</div>}
                </td>
                <td class="px-4 py-3 text-sm text-muted whitespace-nowrap" data-label="Datum">{fmtDate(inv.date)}</td>
                <td class={`px-4 py-3 text-sm whitespace-nowrap font-medium ${inv.status === 'uncollectible' ? 'text-red-400' : 'text-muted'}`} data-label="Fällig">
                  {fmtDate(inv.dueDate)}{inv.status === 'uncollectible' ? ' ⚠' : ''}
                </td>
                <td class="px-4 py-3 text-sm text-light text-right font-medium" data-label="Betrag">{fmtCurrency(inv.amountDue)}</td>
                <td class={`px-4 py-3 text-sm text-right font-medium ${inv.amountRemaining > 0 ? 'text-yellow-400' : 'text-muted'}`} data-label="Offen">
                  {inv.amountRemaining > 0 ? fmtCurrency(inv.amountRemaining) : '—'}
                </td>
                <td class="px-4 py-3 text-sm text-right" data-label="E-Rechnung">
                  {['draft', 'void'].includes(inv.status) ? (
                    <span class="text-xs text-muted/40">—</span>
                  ) : (
                    <a
                      href={`/api/billing/invoice/${inv.id}/zugferd`}
                      download
                      class="text-xs text-green-400 hover:underline"
                      title="ZUGFeRD XML herunterladen"
                    >XML ↓</a>
                  )}
                </td>
                <td class="px-4 py-3 text-sm text-right" data-label="Drucken">
                  {['open', 'partially_paid', 'uncollectible'].includes(inv.status) && (
                    <button
                      class="text-xs text-yellow-400 hover:underline"
                      data-record-payment
                      data-invoice-id={inv.id}
                      data-invoice-number={inv.number}
                      data-outstanding={inv.amountRemaining}
                    >Zahlung ↑</button>
                  )}
                  <a
                    href={`/admin/billing/${inv.id}/drucken`}
                    target="_blank"
                    rel="noopener"
                    class="ml-2 text-xs text-yellow-400 hover:underline"
                    title="Rechnung drucken / als PDF speichern"
                  >Drucken ↗</a>
                </td>
              </tr>
            )))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <div id="payment-modal-mount"></div>

  <dialog id="draft-editor" class="bg-surface border border-border rounded-2xl p-6 w-full max-w-3xl backdrop:bg-black/60">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-lg font-semibold text-light">Rechnungsentwurf prüfen</h3>
      <button id="editor-close" class="text-muted hover:text-light transition-colors text-xl" aria-label="Schließen">✕</button>
    </div>

    <p id="editor-customer" class="mb-1 text-sm text-light"></p>
    <!-- Stufe 3 T10a: Prüfansicht. Positionen ändert Gerald an den Posten in der Klientenakte
         (Entwurf verwerfen, Posten ändern, neu erstellen); die frühere Bearbeitung lief über Stripe ins Leere. -->
    <p class="mb-4 text-xs text-muted">Etwas falsch? Entwurf verwerfen, die Posten in der Klientenakte ändern und die Rechnung dort neu erstellen.</p>

    <table class="w-full text-sm mb-4">
      <thead>
        <tr class="text-muted border-b border-border">
          <th class="text-left py-2 pr-3 font-medium">Leistung</th>
          <th class="text-right py-2 px-3 font-medium w-20">Menge</th>
          <th class="text-right py-2 px-3 font-medium w-28">Einzelpreis</th>
          <th class="text-right py-2 pl-3 font-medium w-28">Betrag</th>
        </tr>
      </thead>
      <tbody id="editor-items"></tbody>
      <tfoot>
        <tr class="border-t border-border font-semibold text-light">
          <td colspan="3" class="py-3 pr-3">Gesamt</td>
          <td class="py-3 pl-3 text-right" id="editor-total"></td>
        </tr>
      </tfoot>
    </table>
    <!-- N2 (Gerald 22.10.2026): Standard aus den Einstellungen, im Einzelfall hier änderbar. -->
    <label class="block text-xs text-muted mb-3">Zahlungsziel in Tagen
      <input id="editor-zahlungsziel" type="number" min="0" max="365" step="1"
        class="ml-2 w-20 px-2 py-1 rounded bg-dark border border-dark-lighter text-sm text-light" />
      <span id="editor-zahlungsziel-hinweis" class="ml-2"></span>
    </label>
    <p id="editor-meldung" role="alert" class="text-sm text-red-400 mb-3"></p>

    <div class="flex gap-3 justify-end flex-wrap">
      <button id="editor-discard-btn"
        class="px-4 py-2 text-sm text-red-400 border border-border rounded-lg hover:border-red-400 transition-colors">
        Verwerfen
      </button>
      <a id="editor-ansehen" href="#" target="_blank" rel="noopener"
        class="px-4 py-2 text-sm border border-border rounded-lg hover:border-gold transition-colors">Ansehen ↗</a>
      <!-- Stufe 4 T14 (K58, K59): ohne E-Mail-Adresse nur „ohne E-Mail“. -->
      <button id="editor-post-btn"
        class="px-4 py-2 text-sm border border-gold text-gold rounded-lg transition-colors disabled:opacity-40">
        Festschreiben ohne E-Mail (Post/persönlich)
      </button>
      <button id="editor-send-btn"
        class="px-4 py-2 text-sm bg-gold hover:bg-gold-light text-dark font-semibold rounded-lg transition-colors disabled:opacity-40">
        Festschreiben und per E-Mail senden
      </button>
    </div>
  </dialog>

<script>
  document.addEventListener('invoice-created', () => window.location.reload());
  // Stufe 4 T19: Klientenwahl für „+ Neue Rechnung“ filtern.
  const wahlSuche = document.getElementById('klient-wahl-suche') as HTMLInputElement | null;
  wahlSuche?.addEventListener('input', () => {
    const t = wahlSuche.value.trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('li.klient-wahl').forEach((li) => { li.hidden = t !== '' && !(li.dataset.suche ?? '').includes(t); });
  });
</script>

<script>
  import { browserLogger } from '$lib/browser-logger';
  import { mount, unmount, type Component } from 'svelte';
  import RecordPaymentModal from '../../components/admin/RecordPaymentModal.svelte';
  type RecordPaymentModalProps = { invoiceId: string; invoiceNumber: string; outstanding: number; onClose: () => void; onSaved: () => void };

  document.querySelectorAll<HTMLButtonElement>('[data-record-payment]').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetEl = document.getElementById('payment-modal-mount')!;
      const app = mount(RecordPaymentModal as unknown as Component<RecordPaymentModalProps>, {
        target: targetEl,
        props: {
          invoiceId: btn.dataset.invoiceId!,
          invoiceNumber: btn.dataset.invoiceNumber!,
          outstanding: Number(btn.dataset.outstanding!),
          onClose: () => unmount(app),
          onSaved: () => { unmount(app); window.location.reload(); },
        },
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-send-dunning]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      const level = btn.dataset.level;
      if (!confirm(`Mahnung ${level} jetzt an den Kunden versenden?`)) return;

      btn.disabled = true;
      btn.textContent = 'Sendet…';

      try {
        const res = await fetch(`/api/admin/billing/dunning/${id}/send`, { method: 'POST' });
        if (res.ok) {
          // Stufe 4 T14 (K60): ohne E-Mail-Adresse als Post vermerkt – PDF aus der Ablage drucken.
          const data = await res.json().catch(() => ({})) as { versand?: string; pdfPath?: string | null };
          if (data.versand === 'post') {
            // Prüfung Stufe 4 (B3): PDF direkt zum Drucken herunterladen.
            alert('Keine E-Mail-Adresse: Mahnung als „per Post“ vermerkt. Das PDF wird jetzt heruntergeladen – bitte drucken und verschicken.');
            const link = document.createElement('a');
            link.href = `/api/admin/billing/dunning/${id}/pdf`; link.download = '';
            document.body.appendChild(link); link.click(); link.remove();
            await new Promise((r) => setTimeout(r, 1200));
          }
          window.location.reload();
        } else {
          alert('Fehler beim Versenden der Mahnung.');
          btn.disabled = false;
          btn.textContent = 'Versenden ↑';
        }
      } catch (err) {
        browserLogger.error({ err }, '[admin/rechnungen] dunning send failed');
        alert('Netzwerkfehler.');
        btn.disabled = false;
        btn.textContent = 'Versenden ↑';
      }
    });
  });
</script>

<script>
  interface DraftItem {
    id: string;
    description: string;
    quantity: number;
    unitPrice: number;
    amount: number;
    leistung: string | null;
  }

  let currentInvoiceId: string | null = null;

  const dialog     = document.getElementById('draft-editor') as HTMLDialogElement;
  const itemsBody  = document.getElementById('editor-items')!;
  const totalCell  = document.getElementById('editor-total')!;
  const customerEl = document.getElementById('editor-customer')!;
  const meldung    = document.getElementById('editor-meldung')!;
  const ansehen    = document.getElementById('editor-ansehen') as HTMLAnchorElement;
  const zielFeld   = document.getElementById('editor-zahlungsziel') as HTMLInputElement;
  const zielHinweis = document.getElementById('editor-zahlungsziel-hinweis')!;

  document.getElementById('editor-close')!.addEventListener('click', () => dialog.close());

  const euro = (n: number) => n.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });

  function zelle(text: string, cls: string): HTMLTableCellElement {
    const td = document.createElement('td');
    td.className = cls;
    td.textContent = text;
    return td;
  }

  // Stufe 3 T10a: nur ansehen; jede Position mit ihrem Leistungsdatum.
  function renderItem(item: DraftItem): HTMLTableRowElement {
    const tr = document.createElement('tr');
    tr.className = 'border-b border-border';
    const desc = zelle(item.description, 'py-2 pr-3 text-light');
    if (item.leistung) {
      const d = document.createElement('span');
      d.className = 'block text-xs text-muted';
      d.textContent = item.leistung;
      desc.appendChild(d);
    }
    tr.append(
      desc,
      zelle(item.quantity.toLocaleString('de-DE'), 'py-2 px-3 text-right'),
      zelle(euro(item.unitPrice), 'py-2 px-3 text-right'),
      zelle(euro(item.amount), 'py-2 pl-3 text-right text-light'),
    );
    return tr;
  }

  function hinweisZeile(text: string): HTMLTableRowElement {
    const tr = document.createElement('tr');
    const td = zelle(text, 'py-4 text-muted text-center');
    td.colSpan = 4;
    tr.appendChild(td);
    return tr;
  }

  async function openDraftEditor(invoiceId: string): Promise<void> {
    currentInvoiceId = invoiceId;
    meldung.textContent = '';
    customerEl.textContent = '';
    ansehen.href = `/admin/billing/${invoiceId}/drucken`;
    itemsBody.replaceChildren(hinweisZeile('Lade…'));
    totalCell.textContent = '';
    dialog.showModal();

    const res = await fetch(`/api/admin/billing/${invoiceId}`);
    if (!res.ok) {
      itemsBody.replaceChildren();
      meldung.textContent = 'Entwurf konnte nicht geladen werden.';
      return;
    }
    const data = await res.json() as {
      number: string; customerName: string; customerEmail: string; items: DraftItem[];
      empfaenger: { name: string; company: string | null; email: string; addressLine1: string | null; postalCode: string | null; city: string | null } | null;
      anschriftFehlt: string[];
      zahlungszielTage: number | null; zahlungszielStandard: number; versandwege: ('email' | 'post')[];
    };
    const ohneEmail = !data.versandwege.includes('email');
    (document.getElementById('editor-send-btn') as HTMLButtonElement).hidden = ohneEmail;
    zielFeld.value = String(data.zahlungszielTage ?? data.zahlungszielStandard);
    zielHinweis.textContent = `Standard aus den Einstellungen: ${data.zahlungszielStandard} Tage`;
    // Stufe 3 T11: An wen die Rechnung beim Festschreiben geht (heutiger Stand der Akte).
    const e = data.empfaenger;
    customerEl.textContent = e
      ? `${data.number} · An: ${e.company ? `${e.company}, z. Hd. ${e.name}` : e.name} · ${[e.addressLine1, [e.postalCode, e.city].filter(Boolean).join(' ')].filter(Boolean).join(', ') || 'ohne Anschrift'} · ${e.email}`
      : `${data.number} · ${data.customerName} · ${data.customerEmail}`;
    const sendKnopf = document.getElementById('editor-send-btn') as HTMLButtonElement;
    sendKnopf.disabled = data.anschriftFehlt.length > 0;
    (document.getElementById('editor-post-btn') as HTMLButtonElement).disabled = data.anschriftFehlt.length > 0;
    if (ohneEmail && data.anschriftFehlt.length === 0) meldung.textContent = '';
    zielHinweis.textContent += ohneEmail ? ' · keine E-Mail-Adresse: nur Versand per Post/persönlich' : '';
    if (data.anschriftFehlt.length > 0) {
      meldung.textContent = `Festschreiben erst möglich, wenn die Rechnungsanschrift vollständig ist. Es fehlt: ${data.anschriftFehlt.join(', ')}. Bitte in der Klientenakte ergänzen.`;
    }
    itemsBody.replaceChildren(...data.items.map(renderItem));
    totalCell.textContent = euro(data.items.reduce((s, i) => s + i.amount, 0));
  }

  async function discardDraft(invoiceId: string): Promise<boolean> {
    if (!confirm('Entwurf wirklich verwerfen? Seine Posten sind danach in der Akte wieder offen.')) return false;
    const res = await fetch(`/api/admin/billing/${invoiceId}/discard`, { method: 'POST' });
    if (!res.ok) {
      alert('Fehler beim Verwerfen. Bitte erneut versuchen.');
      return false;
    }
    document.querySelector(`[data-invoice-id="${invoiceId}"]`)?.remove();
    updateBadge(-1);
    return true;
  }

  function updateBadge(delta: number): void {
    const badge = document.getElementById('draft-badge');
    if (!badge) return;
    const count = Math.max(0, parseInt(badge.textContent ?? '0', 10) + delta);
    badge.textContent = count.toString();
    badge.classList.toggle('hidden', count === 0);
  }

  document.getElementById('draft-list')?.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const btn    = target.closest('button') as HTMLButtonElement | null;
    if (!btn) return;
    const id = btn.dataset.id;
    if (!id) return;
    if (btn.classList.contains('open-draft-btn'))    await openDraftEditor(id);
    if (btn.classList.contains('discard-draft-btn')) await discardDraft(id);
  });

  async function festschreiben(weg: 'email' | 'post'): Promise<void> {
    if (!currentInvoiceId) return;
    const frage = weg === 'email'
      ? 'Rechnung jetzt festschreiben und per E-Mail an den Kunden senden? Danach lässt sie sich nur noch stornieren.'
      : 'Rechnung jetzt festschreiben, ohne E-Mail? Das PDF öffnet sich zum Drucken; vermerkt wird „verschickt per Post“. Danach lässt sie sich nur noch stornieren.';
    if (!confirm(frage)) return;
    const knopf = document.getElementById(weg === 'email' ? 'editor-send-btn' : 'editor-post-btn') as HTMLButtonElement;
    knopf.disabled = true;
    const res = await fetch(`/api/admin/billing/${currentInvoiceId}/send`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ zahlungszielTage: zielFeld.value, versand: weg }),
    });
    knopf.disabled = !res.ok && res.status === 422;
    if (!res.ok) {
      meldung.textContent = `Nicht festgeschrieben: ${(await res.text().catch(() => '')) || 'Fehler'} (${res.status})`;
      return;
    }
    const data = await res.json().catch(() => ({})) as { pdfUrl?: string; number?: string };
    if (data.pdfUrl) {
      // Ohne E-Mail: PDF zum Drucken herunterladen (ein neues Fenster nach dem Warten blockieren Browser oft).
      const link = document.createElement('a');
      link.href = data.pdfUrl; link.download = `${data.number ?? 'Rechnung'}.pdf`;
      document.body.appendChild(link); link.click(); link.remove();
      setTimeout(() => window.location.reload(), 1500);
      return;
    }
    window.location.reload();
  }
  document.getElementById('editor-send-btn')!.addEventListener('click', () => void festschreiben('email'));
  document.getElementById('editor-post-btn')!.addEventListener('click', () => void festschreiben('post'));

  document.getElementById('editor-discard-btn')!.addEventListener('click', async () => {
    if (!currentInvoiceId) return;
    if (await discardDraft(currentInvoiceId)) {
      dialog.close();
      currentInvoiceId = null;
    }
  });
</script>
</AdminLayout>
