---
// Rechnungswesen Stufe 3, T1: Regeln für Absagen und Abrechnung (K17, K36, K39, K40).
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/ui/AdminPageHeader.svelte';
import AdminEinstellungenTabs from '../../../components/AdminEinstellungenTabs.astro';
import { getSession, getLoginUrl, isAdmin } from '../../../lib/auth';
import { REGEL_FELDER, formAus, ladeRegeln, type RegelFehler } from '../../../lib/billing-regeln';

const session = await getSession(Astro.request.headers.get('cookie'));
if (!session) return Astro.redirect(getLoginUrl(Astro.url.pathname));
if (!isAdmin(session)) return Astro.redirect('/admin');

const BRAND = process.env.BRAND || 'mentolder';
const saved = Astro.url.searchParams.get('saved') === '1';

function jsonParam<T>(name: string, fallback: T): T {
  try { return JSON.parse(Astro.url.searchParams.get(name) ?? '') as T; } catch { return fallback; }
}
const fehlerRoh = jsonParam<RegelFehler[]>('fehler', []);
// Kaputte oder fremde URL-Parameter dürfen die Seite nicht zum Absturz bringen.
const fehler = Array.isArray(fehlerRoh) ? fehlerRoh.filter((x) => x && typeof x.key === 'string' && typeof x.meldung === 'string') : [];
const eingabeRoh = jsonParam<Record<string, string>>('eingabe', {});
const eingabe: Record<string, string> = eingabeRoh && typeof eingabeRoh === 'object' && !Array.isArray(eingabeRoh) ? Object.fromEntries(Object.entries(eingabeRoh).map(([k, v]) => [k, String(v)])) : {};

const gespeichert = formAus(await ladeRegeln(BRAND));
const v = { ...gespeichert, ...eingabe };
const fehlerFuer = (key: string) => fehler.find((f) => f.key === key)?.meldung;
const feld = (key: string) => REGEL_FELDER.find((f) => f.key === key)!;

const labelStyle = 'display:block;font-family:var(--font-mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--mute-2);margin-bottom:0.5rem;';
const inputStyle = 'width:100%;background:var(--ink-800);border:1px solid var(--line);border-radius:8px;padding:0.625rem 0.875rem;color:var(--fg);font-family:var(--font-mono);font-size:0.875rem;outline:none;';
const hinweisStyle = 'font-size:0.75rem;color:var(--mute);line-height:1.4;margin-top:0.375rem;';
const fehlerStyle = 'font-size:0.8rem;color:#fca5a5;margin-top:0.375rem;';
---

<AdminLayout title="Regeln">
  <AdminEinstellungenTabs current={Astro.url.pathname} />
  <div class="admin-form-wide" style="padding: 2rem; max-width: 640px;">
    <AdminPageHeader title="Regeln für Absagen und Abrechnung" />

    {saved && (
      <div style="background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1.5rem; color: #86efac; font-size: 0.875rem;">
        Regeln gespeichert. Sie gelten ab sofort.
      </div>
    )}
    {fehler.length > 0 && (
      <div role="alert" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1.5rem; color: #fca5a5; font-size: 0.875rem;">
        Nicht gespeichert. Bitte die markierten Felder korrigieren.
      </div>
    )}

    <form method="POST" action="/api/admin/einstellungen/regeln">
      <p style={labelStyle}>Terminabsage</p>

      <div style="margin-bottom:1.25rem;">
        <label for="frist" style={labelStyle}>{feld('regel_ausfall_frist_stunden').label}</label>
        <input id="frist" type="number" name="regel_ausfall_frist_stunden" value={v.regel_ausfall_frist_stunden} min="0" max="720" step="1" style={inputStyle} />
        <p style={hinweisStyle}>{feld('regel_ausfall_frist_stunden').wirktIn}</p>
        {fehlerFuer('regel_ausfall_frist_stunden') && <p style={fehlerStyle}>{fehlerFuer('regel_ausfall_frist_stunden')}</p>}
      </div>

      <div style="margin-bottom:1.25rem;">
        <span style={labelStyle}>{feld('regel_ausfall_art').label}</span>
        <label style="margin-right:1.25rem;color:var(--fg);font-size:0.875rem;">
          <input type="radio" name="regel_ausfall_art" value="prozent" checked={v.regel_ausfall_art === 'prozent'} /> Prozent des Leistungspreises
        </label>
        <label style="color:var(--fg);font-size:0.875rem;">
          <input type="radio" name="regel_ausfall_art" value="betrag" checked={v.regel_ausfall_art === 'betrag'} /> fester Betrag in Euro
        </label>
        <p style={hinweisStyle}>{feld('regel_ausfall_art').wirktIn}</p>
        {fehlerFuer('regel_ausfall_art') && <p style={fehlerStyle}>{fehlerFuer('regel_ausfall_art')}</p>}
      </div>

      <div style="margin-bottom:2rem;">
        <label for="wert" style={labelStyle}>{feld('regel_ausfall_wert').label}</label>
        <input id="wert" type="text" inputmode="decimal" name="regel_ausfall_wert" value={v.regel_ausfall_wert} style={inputStyle} />
        <p style={hinweisStyle}>{feld('regel_ausfall_wert').wirktIn}</p>
        {fehlerFuer('regel_ausfall_wert') && <p style={fehlerStyle}>{fehlerFuer('regel_ausfall_wert')}</p>}
      </div>

      <p style={labelStyle}>Abrechnung neuer Klienten</p>
      {(['regel_abrechnungsart_firma', 'regel_abrechnungsart_privat'] as const).map((key) => (
        <div style="margin-bottom:1.25rem;">
          <label for={key} style={labelStyle}>{feld(key).label}</label>
          <select id={key} name={key} style={inputStyle}>
            <option value="monatlich" selected={v[key] === 'monatlich'}>monatlich (Sammelrechnung)</option>
            <option value="je_sitzung" selected={v[key] === 'je_sitzung'}>je Sitzung</option>
          </select>
          <p style={hinweisStyle}>{feld(key).wirktIn}</p>
          {fehlerFuer(key) && <p style={fehlerStyle}>{fehlerFuer(key)}</p>}
        </div>
      ))}

      <div style="background:rgba(255,255,255,0.04);border:1px solid var(--line);border-radius:8px;padding:0.75rem 1rem;margin:1.5rem 0;font-size:0.8rem;color:var(--mute);line-height:1.5;">
        Weitere Werte an anderer Stelle:
        <a href="/admin/einstellungen/rechnungen" style="color:var(--brass);">Zahlungsziel und Absenderdaten</a> ·
        <a href="/admin/einstellungen/rechnungstexte" style="color:var(--brass);">Rechnungstexte (Einleitung, Kleinunternehmer-Hinweis, Schluss)</a>
      </div>

      <button type="submit" style="background:var(--brass);color:var(--ink-900);border:none;border-radius:8px;padding:0.625rem 1.25rem;font-family:var(--font-mono);font-size:0.8rem;font-weight:600;cursor:pointer;">
        Speichern
      </button>
    </form>
  </div>
</AdminLayout>
