---
// Rechnungstexte (Wunsch Gerald 20.10.2026): gut auffindbar unter Einstellungen.
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/ui/AdminPageHeader.svelte';
import AdminEinstellungenTabs from '../../../components/AdminEinstellungenTabs.astro';
import { getSession, getLoginUrl, isAdmin } from '../../../lib/auth';
import { RECHNUNGSTEXT_FELDER, RECHNUNGSTEXT_STANDARD, ladeRechnungstexte } from '../../../lib/billing-rechnungstexte';

const session = await getSession(Astro.request.headers.get('cookie'));
if (!session) return Astro.redirect(getLoginUrl(Astro.url.pathname));
if (!isAdmin(session)) return Astro.redirect('/admin');

const BRAND = process.env.BRAND || 'mentolder';
const q = Astro.url.searchParams;
function jsonParam<T>(name: string, fallback: T): T {
  try { return JSON.parse(q.get(name) ?? '') as T; } catch { return fallback; }
}
const fRoh = jsonParam<{ key: string; meldung: string }[]>('fehler', []);
const fehler = Array.isArray(fRoh) ? fRoh.filter((x) => x && typeof x.key === 'string' && typeof x.meldung === 'string') : [];
const eRoh = jsonParam<Record<string, string>>('eingabe', {});
const eingabe = eRoh && typeof eRoh === 'object' && !Array.isArray(eRoh) ? eRoh : {};
const gespeichert = await ladeRechnungstexte(BRAND).catch(() => ({ ...RECHNUNGSTEXT_STANDARD }));
const wert = (k: keyof typeof RECHNUNGSTEXT_STANDARD) => (k in eingabe ? String(eingabe[k]) : gespeichert[k]);
const fehlerFuer = (k: string) => fehler.find((f) => f.key === k)?.meldung;
const saved = q.get('saved') === '1';

const label = 'display:block;font-family:var(--font-mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--mute-2);margin-bottom:0.5rem;';
const input = 'width:100%;background:var(--ink-800);border:1px solid var(--line);border-radius:8px;padding:0.625rem 0.875rem;color:var(--fg);font-size:0.875rem;outline:none;';
const hinweis = 'font-size:0.75rem;color:var(--mute);line-height:1.4;margin-top:0.375rem;';
---

<AdminLayout title="Rechnungstexte">
  <AdminEinstellungenTabs current={Astro.url.pathname} />
  <div class="admin-form-wide" style="padding: 2rem; max-width: 720px;">
    <AdminPageHeader title="Rechnungstexte" />
    <p style="color:var(--mute);font-size:0.875rem;line-height:1.5;margin-bottom:1.5rem;">
      Diese Texte stehen auf jeder neuen Rechnung und in der Rechnungs-E-Mail. Bereits
      festgeschriebene Rechnungen ändern sich nicht.
    </p>

    {saved && (
      <div style="background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1.5rem; color: #86efac; font-size: 0.875rem;">
        Gespeichert. Gilt für neue Rechnungen ab sofort.
      </div>
    )}
    {fehler.length > 0 && (
      <div role="alert" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1.5rem; color: #fca5a5; font-size: 0.875rem;">
        Nicht gespeichert. Bitte die markierten Felder korrigieren.
      </div>
    )}

    <form method="POST" action="/api/admin/einstellungen/rechnungstexte">
      {RECHNUNGSTEXT_FELDER.map((f) => (
        <div style="margin-bottom:1.25rem;">
          <label for={f.key} style={label}>{f.label}{f.pflicht ? ' *' : ''}</label>
          {f.mehrzeilig
            ? <textarea id={f.key} name={f.key} rows="8" maxlength={f.max} style={input}>{wert(f.key)}</textarea>
            : <input id={f.key} name={f.key} maxlength={f.max} value={wert(f.key)} required={f.pflicht} style={input} />}
          <p style={hinweis}>{f.wirktIn}</p>
          {fehlerFuer(f.key) && <p style="font-size:0.8rem;color:#fca5a5;margin-top:0.375rem;">{fehlerFuer(f.key)}</p>}
        </div>
      ))}
      <button type="submit" style="background:var(--brass);color:var(--ink-900);border:none;border-radius:8px;padding:0.625rem 1.25rem;font-size:0.8rem;font-weight:600;cursor:pointer;">
        Speichern
      </button>
    </form>
  </div>
</AdminLayout>
