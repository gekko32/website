---
// Rechnungswesen Stufe 4, T16/T17: ein Angebot prüfen, verschicken, neue Fassung, Antwort (K47–K55).
// Nachtrag 24.10.2026: Entwurf direkt änderbar (K88), Vorlage markieren und neues Angebot daraus (K86, K87),
// Rückfragen auf der Seite statt Browser-Fenster (K92).
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/ui/AdminPageHeader.svelte';
import ZustandLegende from '../../../components/admin/ZustandLegende.astro';
import AkteEintraege from '../../../components/admin/AkteEintraege.astro';
import { eintraegeDesAngebots, WEG_TEXT, ERLAUBTE_ENDUNGEN, type AkteEintrag } from '../../../lib/akte-dokumente';
import { getSession, getLoginUrl, isAdmin } from '../../../lib/auth';
import { holeAngebot, angebotVorschau, geplantePositionenDesAuftrags, standText, entwuerfeDesAngebots } from '../../../lib/billing-angebot';
import { fehlendeAngaben } from '../../../lib/billing-empfaenger';
import { anzeigeEmail, versandwege } from '../../../lib/billing-versand';
import { leistungsdatumZeile } from '../../../lib/leistungszeitraum';
import { postenBetrag, type Posten } from '../../../lib/billing-posten';
import { ladeEinheiten } from '../../../lib/billing-einheiten';
import { listeLeistungen, preisAnzeige } from '../../../lib/billing-leistungen';
import { listKlienten } from '../../../lib/klientenakte';

const session = await getSession(Astro.request.headers.get('cookie'));
if (!session) return Astro.redirect(getLoginUrl(Astro.url.pathname));
if (!isAdmin(session)) return Astro.redirect('/admin');
// Kein Zwischenspeichern: „Zurück“ im Browser zeigt immer den aktuellen Stand.
Astro.response.headers.set('Cache-Control', 'no-store');

const brand = process.env.BRAND || 'mentolder';
const a = await holeAngebot(brand, Astro.params.id ?? '');
if (!a) return Astro.redirect('/admin/angebote');
const entwurf = a.status === 'entwurf';
const { positionen, empfaenger } = await angebotVorschau(brand, a);
// K88: im Entwurf die geplanten Positionen des Auftrags mit allen Feldern (zum Ändern).
const geplant: Posten[] = entwurf && a.auftragId ? await geplantePositionenDesAuftrags(brand, a.auftragId) : [];
const zeileVon = new Map(positionen.map((z) => [z.postenId, z]));
const [einheiten, leistungen, klienten] = await Promise.all([
  entwurf ? ladeEinheiten(brand) : Promise.resolve([] as string[]),
  entwurf ? listeLeistungen(brand, { nurAktiv: true }).catch(() => []) : Promise.resolve([]),
  listKlienten().catch(() => []),
]);
// K102: Nachweise und Notizen zu diesem Angebot.
const nachweise = await eintraegeDesAngebots(brand, a.id).catch((): AkteEintrag[] => []);
const einheitOptionen = (aktuell: string | null) => (aktuell && !einheiten.includes(aktuell) ? [aktuell, ...einheiten] : einheiten);
const fehlt = empfaenger ? fehlendeAngaben(empfaenger) : ['Empfänger'];
const wege = versandwege(empfaenger?.email);
const summe = positionen.reduce((s, z) => Math.round((s + postenBetrag({ menge: z.quantity, einzelpreis: z.unitPrice })) * 100) / 100, 0);
const euro = (n: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(n);
const zahl = (n: number | null) => (n === null ? '' : String(n).replace('.', ','));
const fd = (iso: string | null) => (iso ? iso.slice(0, 10).split('-').reverse().join('.') : '–');
const heute = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Berlin' });
const q = Astro.url.searchParams;
const fehler = q.get('fehler');
const gespeichert = q.get('gespeichert') === '1';
const zurueck = `/admin/angebote/${a.id}`;
const klientName = klienten.find((k) => k.id === a.klientId)?.name ?? empfaenger?.name ?? '';
const akteLink = `/admin/klienten/${a.klientId}#angebote`;
// K128: Entwürfe aus diesem Angebot (bei „je Sitzung“ gleich nach der Annahme angelegt).
const entwuerfe = a.status === 'angenommen' ? await entwuerfeDesAngebots(brand, a.id).catch(() => []) : [];
// K134: aktueller (nicht zurückgezogener) Antwort-Vermerk – Vorbelegung für die Korrektur.
const antwortEintrag = nachweise.find((e) => e.art === (a.status === 'angenommen' ? 'annahme' : 'ablehnung') && !e.zurueckgezogenAm) ?? null;
const knopf = 'px-3 py-1.5 rounded-lg text-sm';
const feld = 'zfeld';
const eingabe = 'block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light';
---

<AdminLayout title={`Angebotsvorschlag ${a.number}`}>
  <div style="padding:2rem;max-width:1000px;">
    {/* K124 (Handtest 29.10.2026): Rückweg zur Akte als deutlicher Knopf. */}
    <div class="flex flex-wrap gap-3 items-center mb-3">
      <a href={akteLink} class="px-3 py-1.5 rounded-lg border border-gold text-gold text-sm font-semibold hover:bg-gold hover:text-dark">← Akte {klientName}</a>
      <a class="text-xs text-muted hover:underline" href="/admin/angebote">Alle Angebotsvorschläge</a>
    </div>
    <AdminPageHeader title={`Angebotsvorschlag ${a.number}`}
      description={`${a.auftragTitel ?? ''} · ${standText(a)}${a.fassung > 1 ? ` · Fassung ${a.fassung}` : ''}${a.vorlageName ? ` · Vorlage „${a.vorlageName}“` : ''}`} />

    {/* K125, K128: nach Versand bzw. Annahme sagen, was passiert ist und wohin es weitergeht. */}
    {q.get('verschickt') === '1' && !entwurf && (
      <div class="meldung-gut mb-4">
        <span>Angebotsvorschlag {a.number} ist verschickt{a.versandweg === 'post' ? ' (Post/persönlich)' : ' (E-Mail)'}.</span>
        <a href={akteLink} class="px-3 py-1.5 rounded-lg bg-gold text-dark text-sm font-semibold">Zurück zur Akte</a>
      </div>
    )}
    {q.get('angenommen') === '1' && a.status === 'angenommen' && (
      <div class="meldung-gut mb-4">
        <span>Annahme vermerkt.{entwuerfe.length > 0
          ? ` Rechnungsentwurf angelegt (${entwuerfe.map((e) => euro(e.betrag)).join(', ')}) – noch nicht verschickt.`
          : ' Die Positionen sind jetzt offene Posten in der Akte.'}</span>
        <span class="flex flex-wrap gap-2">
          {entwuerfe.map((e) => <a href={`/admin/rechnungen/entwurf/${e.id}`} class="px-3 py-1.5 rounded-lg bg-gold text-dark text-sm font-semibold">Entwurf prüfen</a>)}
          <a href={akteLink} class="px-3 py-1.5 rounded-lg border border-gold text-gold text-sm">Zurück zur Akte</a>
        </span>
      </div>
    )}
    {q.get('abgelehnt') === '1' && <div class="meldung-gut mb-4"><span>Ablehnung vermerkt. Nichts wird abgerechnet.</span><a href={akteLink} class="px-3 py-1.5 rounded-lg border border-gold text-gold text-sm">Zurück zur Akte</a></div>}
    {q.get('korrigiert') === '1' && <p class="text-sm text-green-400 mb-3">Vermerk korrigiert. Die Änderung steht im Änderungsprotokoll.</p>}
    {q.get('neu') === '1' && <p class="text-sm text-green-400 mb-3">Neuer Angebotsentwurf angelegt. Positionen lassen sich hier ändern, löschen und ergänzen.</p>}
    {(gespeichert || q.get('eintragGespeichert') === '1') && <p class="text-sm text-green-400 mb-3">Gespeichert.</p>}
    {q.get('eintragFehler') && <p role="alert" class="text-sm text-red-400 mb-3">{q.get('eintragFehler')}</p>}
    {fehler && <p role="alert" class="text-sm text-red-400 mb-3">{fehler}</p>}
    {a.stand === 'abgelaufen' && <p class="text-sm text-gold mb-3">„Gültig bis“ ({fd(a.gueltigBis)}) ist vorbei. Du kannst die Annahme trotzdem vermerken oder eine neue Fassung anlegen.</p>}
    {!entwurf && !a.versendetAm && <p class="text-sm text-gold mb-3">Nummeriert, aber noch nicht verschickt. Unten „Per E-Mail senden“ – oder das PDF selbst weitergeben.</p>}
    {!entwurf && <p class="text-xs text-muted mb-3">Verschickt und damit gesperrt. Ändern geht nur über „Neue Fassung“; als Grundlage für ein anderes Angebot unten „Neues Angebot aus diesem Angebot“.</p>}

    <section class="mb-6">
      <h2 class="text-xs text-muted uppercase tracking-wide mb-1">An</h2>
      {empfaenger ? (
        <p class="text-sm">
          <strong>{empfaenger.company ?? empfaenger.name}</strong>{empfaenger.company && <span class="text-muted"> (z. Hd. {empfaenger.name})</span>}
          <br /><span class="text-muted">{[empfaenger.addressLine1, [empfaenger.postalCode, empfaenger.city].filter(Boolean).join(' ')].filter(Boolean).join(', ') || 'Anschrift fehlt'} · {anzeigeEmail(empfaenger.email)}</span>
        </p>
      ) : <p class="text-sm text-red-400">Empfänger nicht gefunden.</p>}
      {entwurf && fehlt.length > 0 && <p class="text-sm text-red-400 mt-1">Versand erst möglich, wenn die Anschrift vollständig ist. Es fehlt: {fehlt.join(', ')}. Bitte in der Klientenakte ergänzen.</p>}
    </section>

    {/* K88: links anlegen – neue Position direkt im Entwurf (landet im Auftrag). */}
    {entwurf && a.auftragId && (
      <details class="mb-3">
        <summary class="cursor-pointer inline-block px-3 py-1.5 rounded-lg border border-gold text-gold text-sm">+ Neue Position</summary>
        <form method="POST" action="/api/admin/posten" autocomplete="off" class="mt-2 p-3 rounded-lg border border-gold/60 bg-dark">
          <input type="hidden" name="aktion" value="position" /><input type="hidden" name="auftragId" value={a.auftragId} /><input type="hidden" name="zurueck" value={zurueck} />
          <label class="block text-xs text-muted mb-2">Aus Leistungsliste übernehmen (freiwillig)
            <select class={`leistung-uebernehmen ${eingabe}`}>
              <option value="">– freie Position –</option>
              {leistungen.map((l) => <option data-text={l.name} data-einheit={l.einheit} data-preis={l.preis === null ? '' : String(l.preis).replace('.', ',')}>{l.name}{l.preis === null ? '' : ` – ${preisAnzeige({ preis: l.preis, nachVereinbarung: false })}`}</option>)}
            </select>
          </label>
          <div class="grid gap-2 items-end" style="grid-template-columns:repeat(auto-fit,minmax(110px,1fr));">
            <label class="text-xs text-muted">Leistungsdatum (von)<input type="date" name="datum" required value={heute} class={eingabe} /></label>
            <label class="text-xs text-muted">bis (nur bei Zeitraum)<input type="date" name="datumBis" class={eingabe} /></label>
            <label class="text-xs text-muted" style="grid-column:span 2;">Bezeichnung<input name="text" required class={eingabe} /></label>
            <label class="text-xs text-muted">Menge<input name="menge" required value="1" inputmode="decimal" class={eingabe} /></label>
            <label class="text-xs text-muted">Einheit
              <select name="einheit" class={eingabe}><option value="">–</option>{einheiten.map((e) => <option value={e}>{e}</option>)}</select>
            </label>
            <label class="text-xs text-muted">Preis je Einheit in €<input name="preis" required inputmode="decimal" class={eingabe} /></label>
          </div>
          <button type="submit" class="mt-2 px-4 py-1.5 rounded-lg bg-gold text-dark text-sm font-semibold">Position anlegen</button>
        </form>
      </details>
    )}

    <section class="mb-6">
      <h2 class="text-xs text-muted uppercase tracking-wide mb-1">Positionen</h2>
      {positionen.length === 0 ? <p class="text-sm text-muted">Noch keine Positionen{entwurf ? ' – über „+ Neue Position“ hinzufügen.' : '.'}</p> : (
        <table class="w-full text-sm">
          <thead><tr class="text-left text-xs text-muted">
            <th class="py-1 pr-2 font-normal">Leistungsdatum</th><th class="py-1 pr-2 font-normal">Leistung</th>
            <th class="py-1 pr-2 font-normal text-right">Menge × Einzelpreis</th><th class="py-1 pr-2 font-normal text-right">Betrag</th><th></th>
          </tr></thead>
          <tbody>
            {entwurf ? geplant.map((p) => {
              const z = zeileVon.get(p.id);
              const f = `f-${p.id}`;
              return (
              <tr class="zeile border-t border-dark-lighter">
                <td class="py-1 pr-2 whitespace-nowrap align-top">
                  <span class="ansicht">{leistungsdatumZeile({ leistungVon: p.datum, leistungBis: p.datumBis })?.replace('Leistung: ', '') ?? '–'}</span>
                  <span class="bearbeiten">
                    <label class="text-xs text-muted">von<input type="date" name="datum" value={p.datum} form={f} class={feld} required /></label>
                    <label class="text-xs text-muted">bis<input type="date" name="datumBis" value={p.datumBis ?? ''} form={f} class={feld} /></label>
                  </span>
                </td>
                <td class="py-1 pr-2 align-top">
                  <span class="ansicht">{z?.description ?? p.text}</span>
                  <span class="bearbeiten"><input name="text" value={p.text} form={f} aria-label="Bezeichnung" class={feld} required /></span>
                </td>
                <td class="py-1 pr-2 text-right whitespace-nowrap align-top">
                  <span class="ansicht">{p.menge.toLocaleString('de-DE')}{p.einheit ? ` ${p.einheit}` : ''} × {p.einzelpreis === null ? '–' : euro(p.einzelpreis)}</span>
                  <span class="bearbeiten"><span class="inline-flex gap-1 items-center">
                    <input name="menge" value={zahl(p.menge)} inputmode="decimal" form={f} aria-label="Menge" class={`${feld} w-14`} required />
                    <select name="einheit" form={f} aria-label="Einheit" class={`${feld} w-24`}>
                      <option value="" selected={!p.einheit}>–</option>
                      {einheitOptionen(p.einheit).map((e) => <option value={e} selected={e === p.einheit}>{e}</option>)}
                    </select> ×
                    <input name="preis" value={zahl(p.einzelpreis)} inputmode="decimal" form={f} aria-label="Preis je Einheit in €" class={`${feld} w-20`} required />
                  </span></span>
                </td>
                <td class="py-1 pr-2 text-right whitespace-nowrap align-top">{euro(postenBetrag(p))}</td>
                <td class="py-1 text-right whitespace-nowrap align-top">
                  <span class="bearbeiten">
                    <form id={f} method="POST" action="/api/admin/posten" class="inline">
                      <input type="hidden" name="zurueck" value={zurueck} /><input type="hidden" name="aktion" value="position_aendern" /><input type="hidden" name="postenId" value={p.id} />
                      <button type="submit" class="px-2 py-1 rounded bg-gold text-dark text-xs font-semibold">Speichern</button>
                    </form>
                    <button type="button" class="zeile-abbrechen px-2 py-1 rounded border border-dark-lighter text-xs" data-form={f}>Abbrechen</button>
                  </span>
                  <span class="ansicht">
                    <button type="button" class="zeile-aendern px-2 py-1 rounded border border-gold text-gold text-xs">Ändern</button>
                    <form method="POST" action="/api/admin/posten" class="inline mit-rueckfrage" data-frage="Diese Position löschen? Sie verschwindet aus dem Angebot und aus dem Auftrag." data-ja="Löschen">
                      <input type="hidden" name="zurueck" value={zurueck} /><input type="hidden" name="aktion" value="loeschen_auftragsposition" /><input type="hidden" name="postenId" value={p.id} />
                      <button type="submit" class="px-2 py-1 rounded border border-red-400 text-red-300 text-xs">Löschen</button>
                    </form>
                  </span>
                </td>
              </tr>
              ); }) : positionen.map((z) => (
              <tr class="border-t border-dark-lighter">
                <td class="py-1 pr-2 whitespace-nowrap">{leistungsdatumZeile(z)?.replace('Leistung: ', '') ?? '–'}</td>
                <td class="py-1 pr-2">{z.description}</td>
                <td class="py-1 pr-2 text-right whitespace-nowrap">{z.quantity.toLocaleString('de-DE')}{z.unit ? ` ${z.unit}` : ''} × {euro(z.unitPrice)}</td>
                <td class="py-1 pr-2 text-right whitespace-nowrap">{euro(postenBetrag({ menge: z.quantity, einzelpreis: z.unitPrice }))}</td>
                <td></td>
              </tr>))}
            <tr class="border-t-2 border-dark-lighter font-semibold"><td class="py-1" colspan="3">Gesamt</td><td class="py-1 pr-2 text-right">{euro(summe)}</td><td></td></tr>
          </tbody>
        </table>
      )}
    </section>

    <section class="mb-6 text-sm">
      <p class="text-muted">Datum {fd(a.datum)}{a.versendetAm && <> · verschickt {a.versandweg === 'post' ? 'per Post/persönlich' : 'per E-Mail'} am {fd(a.versendetAm)}</>}
        {a.antwortAm && <> · {a.status === 'angenommen' ? 'angenommen' : 'abgelehnt'} am {fd(a.antwortAm)}{a.antwortGrund ? ` (${a.antwortGrund})` : ''}</>}</p>
    </section>

    {entwurf && (
      <section class="border border-dark-lighter rounded-xl p-4 mb-6">
        <label class="block text-xs text-muted mb-3">Gültig bis
          <input id="gueltig-bis" type="date" value={a.gueltigBis} min={heute} class="ml-2 px-2 py-1 rounded bg-dark border border-dark-lighter text-sm text-light" style="color-scheme:dark;" />
        </label>
        <p id="meldung" role="alert" class="text-sm text-red-400 mb-3"></p>
        <div class="flex flex-wrap gap-2 justify-end">
          <form method="POST" action="/api/admin/angebote" class="mit-rueckfrage" data-frage="Angebotsentwurf verwerfen? Die Positionen bleiben im Auftrag." data-ja="Verwerfen">
            <input type="hidden" name="aktion" value="verwerfen" /><input type="hidden" name="id" value={a.id} />
            <button type="submit" class={`${knopf} border border-red-400 text-red-300`}>Verwerfen</button>
          </form>
          <a href={`/api/admin/angebote/${a.id}/pdf`} target="_blank" rel="noopener" class={`${knopf} border border-dark-lighter`}>Vorschau ↗</a>
          <button type="button" data-weg="post" disabled={fehlt.length > 0 || positionen.length === 0} class={`versenden ${knopf} border border-gold text-gold disabled:opacity-40`}>Verschicken ohne E-Mail (Post/persönlich)</button>
          {wege.includes('email') && <button type="button" data-weg="email" disabled={fehlt.length > 0 || positionen.length === 0} class={`versenden ${knopf} bg-gold text-dark font-semibold disabled:opacity-40`}>Nummerieren und E-Mail vorbereiten</button>}
        </div>
        <p class="text-xs text-muted mt-2">{wege.includes('email')
          ? 'Beim Nummerieren bekommt das Angebot seine Nummer und ist danach gesperrt. Danach siehst du die E-Mail (Empfänger, Betreff, Text) und kannst sie vor dem Senden anpassen.'
          : 'Keine E-Mail-Adresse in der Akte: nur Versand per Post/persönlich.'}</p>
      </section>
    )}

    {!entwurf && (
      <div class="flex flex-wrap gap-2 justify-end mb-6">
        <a href={`/api/admin/angebote/${a.id}/pdf`} target="_blank" rel="noopener" class={`${knopf} border border-dark-lighter`}>PDF ↗</a>
        {a.status === 'verschickt' && <button type="button" id="mail-oeffnen" class={`${knopf} bg-gold text-dark font-semibold`}>{a.versandweg === 'email' ? 'Erneut per E-Mail senden' : 'Per E-Mail senden'}</button>}
        {a.status === 'verschickt' && (
          <form id="f-neue-fassung" method="POST" action="/api/admin/angebote" class="mit-rueckfrage" data-frage="Neue Fassung anlegen? Diese Fassung steht danach auf „ersetzt“ und bleibt lesbar; die neue ist ein änderbarer Entwurf." data-ja="Neue Fassung">
            <input type="hidden" name="aktion" value="neue_fassung" /><input type="hidden" name="id" value={a.id} />
            <button type="submit" class={`${knopf} border border-gold text-gold`}>Neue Fassung</button>
          </form>
        )}
      </div>
    )}

    {/* T17 (K52–K55): Antwort des Kunden vermerken – nur bei der neuesten verschickten Fassung. */}
    {/* K132, K133 (Handtest 29.10.2026): Antwort-Felder als erkennbare Eingabe-Kästen; die Rückfrage
        zeigt die eingegebenen Werte noch einmal. */}
    {a.status === 'verschickt' && (
      <section id="antwort" class="mb-6" style="scroll-margin-top:1rem;">
        <h2 class="text-sm font-semibold text-light mb-1">Antwort des Klienten vermerken</h2>
        <p class="text-xs text-muted mb-3">Die Felder sind vorbelegt und änderbar. Bitte vor dem Vermerken prüfen.</p>
        <div class="grid gap-4" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr));">
        <form method="POST" action="/api/admin/angebote" enctype="multipart/form-data" class="mit-rueckfrage mit-werten antwort-kasten antwort-ja" data-frage="Annahme vermerken? Die angebotenen Positionen werden offene Posten und lassen sich abrechnen." data-ja="Annahme vermerken">
          <input type="hidden" name="aktion" value="angenommen" /><input type="hidden" name="id" value={a.id} />
          <p class="antwort-titel">✓ Angenommen</p>
          <label class="vlabel">Datum der Annahme<input type="date" name="datum" value={heute} max={heute} required class="vfeld" data-name="Datum" /></label>
          {a.stand === 'abgelaufen' && <p class="text-xs text-gold mb-2">Hinweis: Das Angebot ist abgelaufen; die Annahme wird mit diesem Vermerk gespeichert.</p>}
          <label class="vlabel">Wie kam die Annahme?
            <select name="weg" class="vfeld" data-name="Weg">
              <option value="">– bitte wählen –</option>
              {Object.entries(WEG_TEXT).map(([k, t]) => <option value={k}>{t}</option>)}
            </select>
          </label>
          <label class="vlabel">Notiz (freiwillig)
            <textarea name="notiz" rows="2" maxlength="5000" placeholder="z. B. Anruf: sagt zu, Start 1.12." class="vfeld" data-name="Notiz"></textarea>
          </label>
          <label class="vlabel">Nachweis als Datei (freiwillig, z. B. Antwort-Mail .eml, PDF, Foto)
            <input type="file" name="datei" accept={ERLAUBTE_ENDUNGEN.map((e) => `.${e}`).join(',')} class="vfeld" data-name="Datei" />
          </label>
          <button type="submit" class={`${knopf} bg-gold text-dark font-semibold mt-1`}>Annahme vermerken …</button>
        </form>
        <form method="POST" action="/api/admin/angebote" enctype="multipart/form-data" class="mit-rueckfrage mit-werten antwort-kasten antwort-nein" data-frage="Ablehnung vermerken? Die Positionen bleiben im Auftrag und werden nicht abgerechnet." data-ja="Ablehnung vermerken">
          <input type="hidden" name="aktion" value="abgelehnt" /><input type="hidden" name="id" value={a.id} />
          <p class="antwort-titel">✗ Abgelehnt</p>
          <label class="vlabel">Datum der Ablehnung<input type="date" name="datum" value={heute} max={heute} required class="vfeld" data-name="Datum" /></label>
          <label class="vlabel">Grund (freiwillig)<input name="grund" maxlength="300" class="vfeld" data-name="Grund" /></label>
          <label class="vlabel">Wie kam die Ablehnung?
            <select name="weg" class="vfeld" data-name="Weg">
              <option value="">– bitte wählen –</option>
              {Object.entries(WEG_TEXT).map(([k, t]) => <option value={k}>{t}</option>)}
            </select>
          </label>
          <label class="vlabel">Notiz (freiwillig)
            <textarea name="notiz" rows="2" maxlength="5000" placeholder="z. B. Anruf: kein Budget dieses Jahr." class="vfeld" data-name="Notiz"></textarea>
          </label>
          <label class="vlabel">Nachweis als Datei (freiwillig, z. B. Antwort-Mail .eml, PDF, Foto)
            <input type="file" name="datei" accept={ERLAUBTE_ENDUNGEN.map((e) => `.${e}`).join(',')} class="vfeld" data-name="Datei" />
          </label>
          <button type="submit" class={`${knopf} border border-red-400 text-red-300 mt-1`}>Ablehnung vermerken …</button>
        </form>
        </div>
      </section>
    )}

    {/* K134 (Handtest 29.10.2026): vermerkte Antwort nachträglich korrigieren. */}
    {(a.status === 'angenommen' || a.status === 'abgelehnt') && (
      <details id="korrektur" class="mb-6" open={fehler !== null}>
        <summary class="cursor-pointer inline-block px-3 py-1.5 rounded-lg border border-gold text-gold text-sm">Vermerk korrigieren (Datum, Weg, {a.status === 'abgelehnt' ? 'Grund, ' : ''}Notiz)</summary>
        <form method="POST" action="/api/admin/angebote" class="mit-rueckfrage mit-werten antwort-kasten mt-2" data-frage={`${a.status === 'angenommen' ? 'Annahme' : 'Ablehnung'} korrigieren? Der bisherige Vermerk bleibt im Änderungsprotokoll sichtbar.`} data-ja="Korrigieren">
          <input type="hidden" name="aktion" value="antwort_korrigieren" /><input type="hidden" name="id" value={a.id} />
          <label class="vlabel">Datum<input type="date" name="datum" value={a.antwortAm?.slice(0, 10) ?? heute} max={heute} required class="vfeld" data-name="Datum" /></label>
          {a.status === 'abgelehnt' && <label class="vlabel">Grund<input name="grund" maxlength="300" value={a.antwortGrund ?? ''} class="vfeld" data-name="Grund" /></label>}
          <label class="vlabel">Weg
            <select name="weg" class="vfeld" data-name="Weg">
              <option value="">– bitte wählen –</option>
              {Object.entries(WEG_TEXT).map(([k, t]) => <option value={k} selected={antwortEintrag?.weg === k}>{t}</option>)}
            </select>
          </label>
          <label class="vlabel">Notiz<textarea name="notiz" rows="2" maxlength="5000" class="vfeld" data-name="Notiz">{(antwortEintrag?.notiz ?? '').split('\n').filter((z) => !/^Grund: /.test(z) && !/^(Annahme|Ablehnung) vermerkt( \(korrigiert\))?$/.test(z)).join('\n')}</textarea></label>
          <p class="text-xs text-muted mb-2">Eine hochgeladene Nachweis-Datei bleibt erhalten.</p>
          <button type="submit" class={`${knopf} bg-gold text-dark font-semibold`}>Korrektur speichern …</button>
        </form>
      </details>
    )}
    {a.status === 'angenommen' && <p class="text-sm text-green-400 mb-6">Angenommen{a.abgelaufenAngenommen ? ' (nach Ablauf)' : ''}. Daraus wurde der Auftrag <a class="underline" href={`/admin/klienten/${a.klientId}#auftrag-${a.auftragId}`}>„{a.auftragTitel}“</a> beauftragt; seine Positionen sind offene Posten und werden wie alle Posten abgerechnet.</p>}

    {/* K100: E-Mail vor dem Senden prüfen und anpassen (wie Rechnung). */}
    {a.status === 'verschickt' && (
    <section id="mail" hidden class="border border-gold/60 rounded-xl p-4 mb-6">
      <h2 class="text-sm font-semibold text-gold mb-3">E-Mail mit Angebot {a.number}</h2>
      <div class="grid gap-3 text-sm">
        <label class="text-xs text-muted">An <input id="mail-an" type="email" autocomplete="off" class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light" /></label>
        <p class="text-xs text-muted">Von: <span id="mail-von" class="text-light"></span> <span class="ml-1">(einstellbar unter <a class="underline" href="/admin/einstellungen/email">Einstellungen → E-Mail</a>)</span></p>
        <label class="text-xs text-muted">Betreff <input id="mail-betreff" class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light" /></label>
        <label class="text-xs text-muted">Text <textarea id="mail-text" rows="9" class="block w-full mt-1 px-2 py-1.5 rounded bg-dark border border-dark-lighter text-sm text-light"></textarea></label>
        <p class="text-xs text-muted">Anhang: <span id="mail-anhaenge" class="text-light"></span> · Vorlage für alle Angebote: <a class="underline" href="/admin/einstellungen/rechnungstexte">Einstellungen → Rechnungstexte</a></p>
        <p id="mail-meldung" role="alert" class="text-sm"></p>
        <div class="flex gap-2 justify-end">
          <button type="button" id="mail-abbrechen" class="px-3 py-2 rounded-lg border border-dark-lighter text-sm">Abbrechen</button>
          <button type="button" id="mail-senden" class="px-3 py-2 rounded-lg bg-gold text-dark text-sm font-semibold">E-Mail senden</button>
        </div>
      </div>
    </section>
    )}

    {/* K102: Nachweise und Notizen zu diesem Angebot (Anruf, Antwort-Mail, Brief …). */}
    {a.klientId && (
    <section id="notizen" class="border border-dark-lighter rounded-xl p-4 mb-6">
      <h2 class="text-xs text-muted uppercase tracking-wide mb-2">Nachweise und Notizen ({nachweise.length})</h2>
      <AkteEintraege eintraege={nachweise} klientId={a.klientId} angebotId={a.id} zurueck={zurueck} />
    </section>
    )}

    {/* Nachtrag 24.10.2026 (K86, K87): Vorlage markieren und neues Angebot aus diesem Angebot. */}
    <section id="vorlage" class="border border-dark-lighter rounded-xl p-4 mb-6 grid gap-4" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr));">
      <form method="POST" action="/api/admin/angebote">
        <input type="hidden" name="id" value={a.id} />
        <p class="text-sm font-semibold text-light mb-1">Als Vorlage {a.vorlageName ? 'markiert' : 'markieren'}</p>
        <p class="text-xs text-muted mb-2">Vorlagen findest du unter <a class="underline" href="/admin/angebote?vorlage=1">Angebotsvorschläge → nur Vorlagen</a>. Am Angebot selbst ändert das nichts.</p>
        <label class="block text-xs text-muted mb-2">Vorlagenname
          <input name="vorlageName" value={a.vorlageName ?? ''} maxlength="120" placeholder="z. B. Moderation Strategietag ganztägig" class={eingabe} />
        </label>
        <div class="flex gap-2">
          <button type="submit" name="aktion" value="vorlage_markieren" class={`${knopf} border border-gold text-gold`}>{a.vorlageName ? 'Namen speichern' : 'Als Vorlage merken'}</button>
          {a.vorlageName && <button type="submit" name="aktion" value="vorlage_entfernen" class={`${knopf} border border-dark-lighter`}>Markierung entfernen</button>}
        </div>
      </form>
      <form method="POST" action="/api/admin/angebote" class="mit-rueckfrage" data-frage="Neues Angebot anlegen? Es entsteht ein neuer Auftrag „mit Angebot“ mit denselben Positionen und ein Angebotsentwurf dazu. Dieses Angebot bleibt unverändert." data-ja="Anlegen">
        <input type="hidden" name="aktion" value="aus_vorlage" /><input type="hidden" name="id" value={a.id} />
        <p class="text-sm font-semibold text-light mb-1">Neues Angebot aus diesem Angebot</p>
        <p class="text-xs text-muted mb-2">Positionen und Preise werden übernommen und sind im neuen Entwurf änderbar; Leistungsdatum ab heute.</p>
        <label class="block text-xs text-muted mb-2">Für Klient
          <select name="zielKlientId" class={eingabe}>
            {klienten.map((k) => <option value={k.id} selected={k.id === a.klientId}>{k.name}{k.email && !k.email.endsWith('.invalid') ? ` (${k.email})` : ''}</option>)}
          </select>
        </label>
        <label class="block text-xs text-muted mb-2">Titel des neuen Auftrags
          <input name="titel" required minlength="2" maxlength="120" value={a.vorlageName ?? a.auftragTitel ?? ''} class={eingabe} />
        </label>
        <button type="submit" class={`${knopf} bg-gold text-dark font-semibold`}>Neues Angebot anlegen</button>
      </form>
    </section>

    <ZustandLegende teile={['angebot']} />

    {/* Rückfrage auf der Seite statt Browser-Fenster (K92). */}
    <div id="rueckfrage" hidden class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4">
      <div class="bg-surface border border-gold/60 rounded-xl p-5 max-w-md w-full shadow-xl">
        <p id="rueckfrage-text" class="text-sm text-light mb-4 whitespace-pre-line"></p>
        <div class="flex gap-2 justify-end">
          <button type="button" id="rueckfrage-nein" class="px-3 py-2 rounded-lg border border-dark-lighter text-sm">Abbrechen</button>
          <button type="button" id="rueckfrage-ja" class="px-3 py-2 rounded-lg bg-gold text-dark text-sm font-semibold">Ja</button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  input[type='date'] { color-scheme: dark; }
  .zeile .bearbeiten { display: none; }
  .zeile.im-bearbeiten .ansicht { display: none; }
  .zeile.im-bearbeiten .bearbeiten { display: block; }
  .zeile.im-bearbeiten { background: var(--color-gold-dim, rgba(200, 170, 90, 0.14)); outline: 1px solid var(--color-gold, #c9a227); }
  .zfeld { display: block; width: 100%; min-width: 0; margin: 0.125rem 0; padding: 0.2rem 0.4rem; border-radius: 0.25rem; font-size: 0.8rem;
    background: var(--color-dark, #111); border: 1px solid var(--color-dark-lighter, #333); color: var(--color-light, #eee); }
  .zfeld.w-14 { width: 3.5rem; } .zfeld.w-20 { width: 5rem; } .zfeld.w-24 { width: 6rem; }
  .inline-flex > .zfeld { display: inline-block; }
  /* K125, K128: Erfolgsmeldung mit dem nächsten Schritt. */
  .meldung-gut { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between;
    padding: 0.75rem 1rem; border: 1px solid #22c55e; background: rgba(34, 197, 94, 0.12); border-radius: 0.75rem; color: #dcfce7; font-size: 0.875rem; }
  /* K132: Antwort-Kästen mit deutlich erkennbaren Eingabefeldern. */
  .antwort-kasten { border: 1px solid var(--color-dark-lighter, #333); border-radius: 0.75rem; padding: 1rem; background: rgba(255, 255, 255, 0.03); }
  .antwort-ja { border-left: 4px solid #22c55e; }
  .antwort-nein { border-left: 4px solid #f87171; }
  .antwort-titel { font-size: 0.95rem; font-weight: 600; color: var(--color-light, #eee); margin-bottom: 0.75rem; }
  .vlabel { display: block; font-size: 0.75rem; color: var(--color-light, #eee); margin-bottom: 0.75rem; }
  .vfeld { display: block; width: 100%; margin-top: 0.25rem; padding: 0.45rem 0.6rem; border-radius: 0.375rem; font-size: 0.875rem;
    background: #0c0c0c; border: 1.5px solid rgba(255, 255, 255, 0.4); color: var(--color-light, #eee); }
  .vfeld:focus { outline: none; border-color: var(--color-gold, #c9a227); box-shadow: 0 0 0 2px rgba(201, 162, 39, 0.35); }
</style>

<script define:vars={{ id: a.id }}>
  const box = document.getElementById('rueckfrage');
  function frage(text, ja = 'Ja') {
    return new Promise((fertig) => {
      const jaK = document.getElementById('rueckfrage-ja');
      const neinK = document.getElementById('rueckfrage-nein');
      document.getElementById('rueckfrage-text').textContent = text;
      jaK.textContent = ja;
      box.hidden = false;
      const zu = (w) => { box.hidden = true; jaK.onclick = null; neinK.onclick = null; fertig(w); };
      jaK.onclick = () => zu(true);
      neinK.onclick = () => zu(false);
    });
  }
  // K133: bei Formularen „mit-werten“ zeigt die Rückfrage die eingegebenen Werte noch einmal.
  function werteText(f) {
    const zeilen = [];
    f.querySelectorAll('[data-name]').forEach((el) => {
      let w = '';
      if (el.type === 'date' && el.value) w = el.value.split('-').reverse().join('.');
      else if (el.type === 'file') w = el.files?.[0]?.name ?? '';
      else if (el.tagName === 'SELECT') w = el.value ? el.selectedOptions[0]?.textContent ?? '' : '';
      else w = el.value.trim();
      zeilen.push(`${el.dataset.name}: ${w ? (w.length > 80 ? `${w.slice(0, 80)} …` : w) : '–'}`);
    });
    return zeilen.join('\n');
  }
  document.querySelectorAll('form.mit-rueckfrage').forEach((f) => f.addEventListener('submit', async (e) => {
    if (f.dataset.bestaetigt === '1') return;
    e.preventDefault();
    const text = f.classList.contains('mit-werten') ? `${f.dataset.frage}\n\n${werteText(f)}` : f.dataset.frage;
    if (await frage(text, f.dataset.ja)) { f.dataset.bestaetigt = '1'; f.requestSubmit(); }
  }));
  // K148 (Prüfung D1): „Vermerk korrigieren ›“ springt auf #korrektur – dann gleich aufklappen.
  const oeffneKorrektur = () => { if (location.hash === '#korrektur') document.getElementById('korrektur')?.setAttribute('open', ''); };
  oeffneKorrektur();
  window.addEventListener('hashchange', oeffneKorrektur);
  // K126: aus der Akte „Ändern (neue Fassung)“ → gleich die Rückfrage zur neuen Fassung zeigen.
  if (new URLSearchParams(location.search).get('neueFassung') === '1') {
    // Prüfung B7: beim Neuladen nicht noch einmal fragen.
    history.replaceState(null, '', location.pathname);
    document.getElementById('f-neue-fassung')?.requestSubmit();
  }
  document.querySelectorAll('.zeile-aendern').forEach((b) => b.addEventListener('click', () => b.closest('.zeile')?.classList.add('im-bearbeiten')));
  document.querySelectorAll('.zeile-abbrechen').forEach((b) => b.addEventListener('click', () => {
    document.getElementById(b.dataset.form)?.reset();
    b.closest('.zeile')?.classList.remove('im-bearbeiten');
  }));
  document.querySelectorAll('select.leistung-uebernehmen').forEach((wahl) => wahl.addEventListener('change', () => {
    const o = wahl.selectedOptions[0];
    const f = wahl.form;
    if (!o || !f || !o.dataset.text) return;
    f.elements.namedItem('text').value = o.dataset.text ?? '';
    f.elements.namedItem('preis').value = o.dataset.preis ?? '';
    const e = f.elements.namedItem('einheit');
    if (e && o.dataset.einheit) {
      if (![...e.options].some((x) => x.value === o.dataset.einheit)) e.add(new Option(o.dataset.einheit, o.dataset.einheit));
      e.value = o.dataset.einheit;
    }
  }));

  const meldung = document.getElementById('meldung');
  // Prüfung Stufe 4 (B5): „gültig bis“ beim Ändern sofort speichern.
  document.getElementById('gueltig-bis')?.addEventListener('change', async (e) => {
    const res = await fetch('/api/admin/angebote', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ aktion: 'gueltig_bis', id, gueltigBis: e.target.value }),
    });
    const data = await res.json().catch(() => ({}));
    if (meldung) { meldung.className = res.ok ? 'text-sm text-green-400 mb-3' : 'text-sm text-red-400 mb-3'; meldung.textContent = res.ok ? '„Gültig bis“ gespeichert.' : (data.error ?? 'Nicht gespeichert.'); }
  });
  document.querySelectorAll('button.versenden').forEach((b) => b.addEventListener('click', async () => {
    const weg = b.dataset.weg;
    const text = weg === 'email'
      ? 'Angebot jetzt nummerieren und per E-Mail verschicken? Danach lässt es sich nur über eine neue Fassung ändern.'
      : 'Angebot jetzt nummerieren, ohne E-Mail? Das PDF wird heruntergeladen; vermerkt wird „verschickt per Post“.';
    if (!(await frage(text, 'Verschicken'))) return;
    b.disabled = true;
    const res = await fetch('/api/admin/angebote', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ aktion: 'versenden', id, versand: weg, gueltigBis: document.getElementById('gueltig-bis')?.value }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) { b.disabled = false; if (meldung) { meldung.className = 'text-sm text-red-400 mb-3'; meldung.textContent = data.error ?? 'Nicht verschickt.'; } }
    if (data.pdfUrl) {
      const link = document.createElement('a');
      link.href = data.pdfUrl; link.download = ''; // Dateiname vom Server (K117)
      document.body.appendChild(link); link.click(); link.remove();
    }
    if (res.ok) setTimeout(() => { window.location.href = `/admin/angebote/${id}${weg === 'email' ? '?mail=1' : '?verschickt=1'}`; }, data.pdfUrl ? 1500 : 0);
  }));

  // K100: E-Mail vorbereiten und senden.
  const mail = document.getElementById('mail');
  const mailMeldung = document.getElementById('mail-meldung');
  const zeigeMail = (text, gut) => { if (mailMeldung) { mailMeldung.className = `text-sm ${gut ? 'text-green-400' : 'text-red-400'}`; mailMeldung.textContent = text; } };
  async function mailOeffnen() {
    if (!mail) return;
    mail.hidden = false;
    mail.scrollIntoView({ behavior: 'smooth', block: 'start' });
    const res = await fetch(`/api/admin/angebote/${id}/mail`);
    const v = await res.json().catch(() => ({}));
    if (!res.ok) { zeigeMail(v.error ?? 'E-Mail-Vorschlag nicht geladen.', false); return; }
    document.getElementById('mail-an').value = v.an ?? '';
    document.getElementById('mail-von').textContent = v.von ?? '';
    document.getElementById('mail-betreff').value = v.betreff ?? '';
    document.getElementById('mail-text').value = v.text ?? '';
    document.getElementById('mail-anhaenge').textContent = (v.anhaenge ?? []).join(', ');
  }
  document.getElementById('mail-oeffnen')?.addEventListener('click', mailOeffnen);
  document.getElementById('mail-abbrechen')?.addEventListener('click', () => { if (mail) mail.hidden = true; });
  document.getElementById('mail-senden')?.addEventListener('click', async (e) => {
    const k = e.currentTarget;
    const an = document.getElementById('mail-an').value;
    if (!(await frage(`E-Mail jetzt an ${an} senden?`, 'Senden'))) return;
    k.disabled = true;
    zeigeMail('Wird gesendet …', true);
    const res = await fetch(`/api/admin/angebote/${id}/mail`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ an, betreff: document.getElementById('mail-betreff').value, text: document.getElementById('mail-text').value }),
    });
    const data = await res.json().catch(() => ({}));
    k.disabled = false;
    if (!res.ok) { zeigeMail(data.error ?? 'E-Mail nicht gesendet.', false); k.textContent = 'Nochmal versuchen'; return; }
    zeigeMail('E-Mail gesendet.', true);
    setTimeout(() => window.location.replace(`/admin/angebote/${id}?verschickt=1`), 1200);
  });
  if (new URLSearchParams(location.search).get('mail') === '1') void mailOeffnen();
</script>
